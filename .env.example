# ---- Plane ----
PLANE_BASE_URL=https://api.plane.so
PLANE_API_TOKEN=plane_api_xxx
PLANE_WORKSPACE_SLUG=          # Plane 网页版 URL 中的工作区段，待填
PLANE_READY_STATE=Ready

# ---- DB ----
DATABASE_URL=postgres://dfh:dfh@localhost:5432/deepflowhunter

# ---- 调度 ----
MAX_GLOBAL_JOBS=6
MAX_JOBS_PER_PROJECT=2
DEFAULT_AUDIT_TIMEOUT_SEC=3600
DEFAULT_VERIFY_TIMEOUT_SEC=1800
LEASE_TTL_SEC=120
HEARTBEAT_INTERVAL_SEC=30
REAPER_INTERVAL_SEC=30
# 任务触发全程事件驱动（jobs 表 LISTEN/NOTIFY）；以下轮询仅为兜底，默认关闭
DFH_DISPATCH_POLL_SEC=0        # >0 时开启调度领取兜底轮询（调试用）
PLANE_POLL_INTERVAL_SEC=0      # >0 时开启 Plane 轮询（webhook 不可达环境的兜底）

# ---- 派生规则 ----
AUTO_VERIFY_SEVERITIES=high,critical
MAX_FOLLOWUPS_PER_JOB=10
MAX_FOLLOWUP_DEPTH=2

# ---- hub 循环（图语义自驱审计，§8.3；默认关闭，可 per-project rules 覆盖） ----
DFH_HUB_ENABLED=false
DFH_HUB_MAX_ROUNDS=10
DFH_HUB_MAX_INTENTS=3

# ---- 运行时 ----
SANDBOX_PROVIDER=local-docker
DOCKER_IMAGE_AUDIT=deepflowhunter-agent:latest
# fake=内置假 agent（联调/演示）；real=agentbox-sdk 真实 agent（需镜像与凭据）
AGENT_MODE=fake
# 沙箱内跑哪个 Agent CLI（agentbox-sdk 支持三家，同一 API 可换）：claude-code | opencode | codex
AGENT_PROVIDER=claude-code
# 沙箱内默认模型（可选，如 sonnet / opus / gpt-5.3-codex）
AGENT_MODEL=

# ---- Agent 凭据（按 AGENT_PROVIDER 选填，密钥仅调度器持有并注入沙箱） ----
# Claude Code：官方直连只填 API_KEY；走中转/代理填 BASE_URL + AUTH_TOKEN
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# Codex：官方或任意 OpenAI 兼容端点（配 OPENAI_BASE_URL）
OPENAI_API_KEY=
OPENAI_BASE_URL=
# OpenCode / Codex 走 OpenRouter（可选）
OPENROUTER_API_KEY=

# ---- 事件与存储 ----
EVENT_PAYLOAD_MAX_KB=256
BLOB_STORE=fs
BLOB_DIR=./data/blobs
TRANSCRIPT_RETENTION_DAYS=90
EVENT_FLUSH_INTERVAL_MS=2000
EVENT_FLUSH_MAX_KB=32
SEARCH_STATEMENT_TIMEOUT_MS=3000

# ---- 服务 ----
SCHEDULER_PORT=3100
PLANE_WEBHOOK_SECRET=
