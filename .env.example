# =============================================================================
# DeepSonar 环境变量示例（复制为仓库根目录 .env 后按需修改）
# 调度器启动时自动加载；不覆盖进程中已有环境变量。
# =============================================================================

# ---- Plane（可选；不配置则纯本地：Web 直接建项目/任务） ----
PLANE_BASE_URL=https://api.plane.so
PLANE_API_TOKEN=plane_api_xxx
PLANE_WORKSPACE_SLUG=          # Plane 网页 URL 中的工作区段
PLANE_WEB_URL=                 # 前端地址（可选；默认 api.plane.so → app.plane.so）
PLANE_READY_STATE=Ready
PLANE_IN_PROGRESS_STATE=In Progress
PLANE_DONE_STATE=Done
PLANE_WEBHOOK_SECRET=          # /webhooks/plane 签名校验（可选）

# ---- 数据库 ----
# 默认对接 pnpm db:up 的独立开发库。pnpm db:up:deploy 会改写成 deploy 栈密码。
DATABASE_URL=postgres://deepsonar:deepsonar@localhost:5432/deepsonar
DEEPSONAR_DB_POOL_MAX=10
DEEPSONAR_DB_STATEMENT_TIMEOUT_MS=60000
DEEPSONAR_DB_IDLE_TIMEOUT_SEC=30
DEEPSONAR_DB_CONNECT_TIMEOUT_SEC=10

# ---- 服务监听 ----
SCHEDULER_PORT=3100
SCHEDULER_HOST=127.0.0.1       # 默认回环；容器/生产需 0.0.0.0 时务必开鉴权

# 控制台 /health.version（优先 DEEPSONAR_VERSION，否则 DEEPSONAR_IMAGE_TAG）。
# 部署真相是镜像标签，不要用 apps/web/package.json。未设置时界面显示 —。
# DEEPSONAR_VERSION=
# DEEPSONAR_IMAGE_TAG=0.1.37

# ---- 平台鉴权与用户登录（SEC-01）----
# true：业务 API 必须 Bearer；Web 跳转 /login
# false：本地开发免登录（无 Token 时 actor=internal 全权限）——勿对公网暴露
DEEPSONAR_AUTH_REQUIRED=false
# 引导管理员 Token（不落库）：首次建 API Token / 应急；生产请设强随机串
DEEPSONAR_ADMIN_TOKEN=
# Token 环境段：deepsonar_<env>_<prefix>_<secret>
# 用户会话：deepsonar_user_<env>_<prefix>_<secret>（登录后签发，默认 7 天）
DEEPSONAR_TOKEN_ENV=dev
# 空库启动时自动创建一次默认管理员：admin / Deep@Sonar66；生产首次登录后必须立即改密并建议改名
# 兼容旧客户端仍可调用 /auth/bootstrap（默认种子存在时返回 409）
# Agent 管理 → 我的账号：修改自己的用户名/密码；用户：admin 可建号 / 禁用 / 重置密码

# ---- Provider Credential 主密钥（§6.2，与密文分存）----
# 生成：openssl rand -hex 32 > .deepsonar-master-key
DEEPSONAR_MASTER_KEY_FILE=.deepsonar-master-key
DEEPSONAR_MASTER_KEY=

# ---- 调度并发与超时 ----
MAX_GLOBAL_JOBS=20
MAX_JOBS_PER_PROJECT=5
PROVISION_CONCURRENCY=2       # global_settings.maxConcurrentProvisioning 缺失时 fallback；DB claim admission，不是 semaphore
DEFAULT_AUDIT_TIMEOUT_SEC=7200
DEFAULT_VERIFY_TIMEOUT_SEC=3600
LEASE_TTL_SEC=120
HEARTBEAT_INTERVAL_SEC=30
REAPER_INTERVAL_SEC=30
PROVISION_TIMEOUT_SEC=300      # 起沙箱超时（Reaper 判 failed）
# Node statfs 检查 Docker 数据目录所在宿主文件系统；error 水位暂停新 claim，恢复后自动唤醒。
DEEPSONAR_HOST_DISK_PATH=/
DEEPSONAR_HOST_DISK_WARNING_PERCENT=85
DEEPSONAR_HOST_DISK_ERROR_PERCENT=90
DEEPSONAR_HOST_DISK_CHECK_INTERVAL_SEC=30
# 事件驱动为主（pg_notify）；下列轮询默认关闭
DEEPSONAR_DISPATCH_POLL_SEC=0  # >0 调度领取兜底轮询
PLANE_POLL_INTERVAL_SEC=0      # >0 Plane 轮询兜底（无 webhook 时）

# ---- 派生与关注级别（env 兜底；库内 global_settings / 项目 rules 可覆盖）----
# 解析为 minVerifySeverity：列表中最「松」的一档；默认 critical,high → 只自动验高危
# Hub 等待门 / 验完停自驱 / 调度优先级均由此推导（见全局规则「最低关注级别」）
AUTO_VERIFY_SEVERITIES=critical,high
MAX_FOLLOWUPS_PER_JOB=60       # 单父 job 最多自动派生 verify 数
MAX_FOLLOWUP_DEPTH=12          # 派生链最大深度
MAX_AUTO_RETRIES=6

# ---- Hub 循环（图语义自驱；项目 rules 可覆盖）----
DEEPSONAR_HUB_ENABLED=true
DEEPSONAR_HUB_MAX_ROUNDS=20    # 仅统计 succeeded 的 hub 轮次
DEEPSONAR_HUB_MAX_INTENTS=6    # 单次决策最多下发 intent 数
# Server-side graph prompt projection budgets (characters)
MAX_GRAPH_YAML_CHARS_HUB=48000
MAX_GRAPH_YAML_CHARS_AGENT=16000
MAX_GRAPH_YAML_CHARS_VERIFY=24000
MAX_GRAPH_YAML_CHARS_REPORT=8000
MAX_FINDING_REPORT_INPUT_CHARS=40000
# 人类对 confirmed Finding 评论 → 写入画布并唤醒 Hub 再决策（尊重「暂停决策」）

# ---- 运行时 / Agent ----
SANDBOX_PROVIDER=local-docker
DOCKER_IMAGE_AUDIT=deepsonar-agent:latest
# real 模式必须配置官方镜像的不可变引用；tag 只保留给升级期兼容，不会进入 Job 快照。
DEEPSONAR_OFFICIAL_BASE_IMAGE=       # ghcr.io/.../deepsonar-base@sha256:...
DEEPSONAR_OFFICIAL_AUDIT_IMAGE=      # ghcr.io/.../deepsonar-audit@sha256:...
DEEPSONAR_OFFICIAL_KALI_MINIMAL_IMAGE= # ghcr.io/.../deepsonar-kali-minimal@sha256:...（Test 默认）
DEEPSONAR_ALLOWED_IMAGE_REGISTRIES=ghcr.io,docker.io,registry-1.docker.io
DEEPSONAR_RUNTIME_REGISTRY_SYNC_SEC=3600 # 定时获取官方 GitHub Release 最新清单；失败回退内置清单
DEEPSONAR_RUNTIME_IMAGE_GC_INTERVAL_SEC=21600 # 安全 GC 周期；只删 DB 已知旧 immutable ref，0=关闭
# 可选：Scheduler 读取 SummerSec/DeepSonar 私有 GitHub Release metadata/asset；最小 contents:read，仅发往 GitHub API，不下发沙箱。
DEEPSONAR_RUNTIME_REGISTRY_GITHUB_TOKEN=
# 独立准入 Worker 使用的扫描器镜像也必须固定 digest；未配置时第三方准入会明确失败。
DEEPSONAR_COSIGN_IMAGE=              # gcr.io/projectsigstore/cosign/...@sha256:...
DEEPSONAR_SYFT_IMAGE=                # anchore/syft@sha256:...
DEEPSONAR_TRIVY_IMAGE=               # aquasec/trivy@sha256:...
DEEPSONAR_CLAMAV_IMAGE=              # clamav/clamav@sha256:...
DEEPSONAR_IMAGE_SCAN_VOLUME=deepsonar_admission_scan
DEEPSONAR_IMAGE_ADMISSION_POLL_MS=5000
DEEPSONAR_IMAGE_UPDATE_CHECK_SEC=21600
DEEPSONAR_IMAGE_RESCAN_SEC=86400
# fake=内置假 agent（联调/演示）；real=agentbox-sdk 真实 agent（需镜像与凭据）
AGENT_MODE=real
# 共享资产卷写入 helper；必须是 immutable digest。real 部署优先解析官方 helper RepoDigest，未发布前用此 busybox pin；fake 不使用
DEEPSONAR_SHARED_ASSETS_HELPER_IMAGE=docker.io/library/busybox@sha256:fc6dddc4c44b1bfe37f41cae8e67d1693828e8f42a91862816d7953e2c9d3f23
# 角色的 agent_cli/model/env_vars 只能通过 RoleConfig / Agents UI/API 设置，并在 Job 创建时冻结快照。

# ---- Agent 凭据 ----
# Provider settings 由 Settings / Credentials UI/API 保存，并按 Job 完整物化为 CLI 配置文件；不从部署 env 注入 Agent。

# ---- Model Gateway（仅供无 settings_config_json 的历史 Credential 兼容及 OTLP 回传）----
DEEPSONAR_GATEWAY_SANDBOX_URL=http://host.docker.internal:3100/gateway
DEEPSONAR_GATEWAY_RESTRICTED_URL=http://deepsonar-gateway-proxy:3100/gateway
DEEPSONAR_JOB_TOKEN_MAX_REQUESTS=500
DEEPSONAR_JOB_TOKEN_TTL_SEC=14400
DEEPSONAR_GATEWAY_UPSTREAM_TIMEOUT_MS=3000000

# ---- 事件与 Blob ----
EVENT_PAYLOAD_MAX_KB=256
# Shared-asset CAS bytes: fs (default for local development) | s3 (any S3-compatible API)
BLOB_STORE=fs
# Evidence/report cold storage + fs backend root + s3 materialize cache default
BLOB_DIR=./data/blobs
# --- optional when BLOB_STORE=s3 (Silo, AWS S3, Garage, SeaweedFS, cloud OSS, …) ---
# BLOB_S3_ENDPOINT=http://127.0.0.1:9000
# BLOB_S3_REGION=us-east-1
# BLOB_S3_BUCKET=deepsonar
# BLOB_S3_PREFIX=
# BLOB_S3_ACCESS_KEY_ID=
# BLOB_S3_SECRET_ACCESS_KEY=
# BLOB_S3_FORCE_PATH_STYLE=true
# BLOB_S3_CACHE_DIR=./data/blobs
# Docs: docs/SHARED_ASSET_BLOB_STORE.md
TRANSCRIPT_RETENTION_DAYS=90
EVENT_FLUSH_INTERVAL_MS=2000
EVENT_FLUSH_MAX_KB=32
SEARCH_STATEMENT_TIMEOUT_MS=3000

# ---- RoleConfig env 白名单（逗号分隔，支持前缀通配）----
DEEPSONAR_ALLOWED_ENV_KEYS=ANTHROPIC_*,OPENAI_*

# ---- 沙箱硬限制（SEC-03）----
DEEPSONAR_SANDBOX_CPU=2
DEEPSONAR_SANDBOX_MEMORY_MIB=2048
DEEPSONAR_SANDBOX_PIDS=512
DEEPSONAR_SANDBOX_CAP_DROP_ALL=true
DEEPSONAR_SANDBOX_NO_NEW_PRIVILEGES=true

# ---- 代码摄入（§10）----
DEEPSONAR_REPO_MAX_FILES=2000
DEEPSONAR_REPO_MAX_TOTAL_MB=20
DEEPSONAR_REPO_MAX_FILE_KB=512
DEEPSONAR_GIT_CLONE_TIMEOUT_SEC=120
DEEPSONAR_GIT_ALLOWED_HOSTS=       # 逗号分隔；空=任意 https host
DEEPSONAR_REPO_LOCAL_ROOTS=        # 逗号分隔本地根；空=不限制 repo_path

# ---- 数据导入导出（应用级 .deepsonarpack，非 pg_dump）----
# 产物目录默认：进程 cwd 下 data/transfers/{exports,imports,tmp}
# 项目：/projects/:id/exports  平台：/platform/exports
# 导出默认不含 Secret 明文 / API Token / Job Token / 主密钥

# 启动时同步已信任模块源（默认 true）
DEEPSONAR_SKILL_SOURCE_BOOT_SYNC=true
