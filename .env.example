# ---- Plane（可选集成；不配置则纯本地模式：Web 直接创建项目/任务即可跑全流程） ----
PLANE_BASE_URL=https://api.plane.so
PLANE_API_TOKEN=plane_api_xxx
PLANE_WORKSPACE_SLUG=          # Plane 网页版 URL 中的工作区段，待填
PLANE_WEB_URL=                 # Plane 前端地址（可选；默认从 BASE_URL 推导，api.plane.so → app.plane.so）
PLANE_READY_STATE=Ready

# ---- DB ----
DATABASE_URL=postgres://deepsonar:deepsonar@localhost:5432/deepsonar

# ---- 调度 ----
MAX_GLOBAL_JOBS=6
MAX_JOBS_PER_PROJECT=2
DEFAULT_AUDIT_TIMEOUT_SEC=7200
DEFAULT_VERIFY_TIMEOUT_SEC=3600
LEASE_TTL_SEC=120
HEARTBEAT_INTERVAL_SEC=30
REAPER_INTERVAL_SEC=30
# 任务触发全程事件驱动（jobs 表 LISTEN/NOTIFY）；以下轮询仅为兜底，默认关闭
DEEPSONAR_DISPATCH_POLL_SEC=0        # >0 时开启调度领取兜底轮询（调试用）
PLANE_POLL_INTERVAL_SEC=0      # >0 时开启 Plane 轮询（webhook 不可达环境的兜底）

# ---- 派生规则 ----
AUTO_VERIFY_SEVERITIES=low,medium,high,critical
MAX_FOLLOWUPS_PER_JOB=20
MAX_FOLLOWUP_DEPTH=4
MAX_AUTO_RETRIES=6

# ---- hub 循环（图语义自驱审计，§8.3；默认关闭，可 per-project rules 覆盖） ----
DEEPSONAR_HUB_ENABLED=false
DEEPSONAR_HUB_MAX_ROUNDS=20
DEEPSONAR_HUB_MAX_INTENTS=6

# ---- 运行时 ----
SANDBOX_PROVIDER=local-docker
DOCKER_IMAGE_AUDIT=deepsonar-agent:latest
# fake=内置假 agent（联调/演示）；real=agentbox-sdk 真实 agent（需镜像与凭据）
AGENT_MODE=fake
# 沙箱内跑哪个 Agent CLI（agentbox-sdk 支持三家，同一 API 可换）：claude-code | opencode | codex
AGENT_PROVIDER=claude-code
# 沙箱内默认模型（可选，如 sonnet / opus / gpt-5.3-codex）
AGENT_MODEL=

# ---- Agent 凭据（按 AGENT_PROVIDER 选填，密钥仅调度器持有并注入沙箱） ----
# Claude Code：官方直连只填 API_KEY；走中转/代理填 BASE_URL + AUTH_TOKEN
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# Codex：官方或任意 OpenAI 兼容端点（配 OPENAI_BASE_URL）
OPENAI_API_KEY=
OPENAI_BASE_URL=
# OpenCode / Codex 走 OpenRouter（可选）
OPENROUTER_API_KEY=

# ---- 事件与存储 ----
EVENT_PAYLOAD_MAX_KB=256
BLOB_STORE=fs
BLOB_DIR=./data/blobs
TRANSCRIPT_RETENTION_DAYS=90
EVENT_FLUSH_INTERVAL_MS=2000
EVENT_FLUSH_MAX_KB=32
SEARCH_STATEMENT_TIMEOUT_MS=3000

# ---- 服务 ----
SCHEDULER_PORT=3100
SCHEDULER_HOST=127.0.0.1     # 默认只绑回环（可信网络）；容器部署显式改 0.0.0.0
# 平台 API Token 鉴权（SEC-01）：绑定地址跨出回环时必须开启
DEEPSONAR_AUTH_REQUIRED=false
DEEPSONAR_ADMIN_TOKEN=             # 引导管理员 token（不落库），用于首次创建 DB token
DEEPSONAR_TOKEN_ENV=dev            # token 格式环境段：deepsonar_<env>_<prefix>_<secret>
# Provider Credential 主密钥（§6.2）：32 字节 hex/base64；与密文不同库
# 生成：openssl rand -hex 32 > .deepsonar-master-key（文件已入 .gitignore）
DEEPSONAR_MASTER_KEY_FILE=.deepsonar-master-key
DEEPSONAR_MASTER_KEY=
PLANE_WEBHOOK_SECRET=
# profile env_keys 白名单（逗号分隔，支持前缀通配）；不在名单的变量名拒绝注入沙箱
DEEPSONAR_ALLOWED_ENV_KEYS=ANTHROPIC_*,OPENAI_*,OPENROUTER_*

# ---- 沙箱资源限制（SEC-03）----
DEEPSONAR_SANDBOX_CPU=2              # CPU 核数上限
DEEPSONAR_SANDBOX_MEMORY_MIB=2048    # 内存上限 MiB
DEEPSONAR_SANDBOX_PIDS=512           # PID 数上限（防 fork 炸弹）
DEEPSONAR_SANDBOX_CAP_DROP_ALL=true  # 去掉全部 Linux capability
DEEPSONAR_SANDBOX_NO_NEW_PRIVILEGES=true
PROVISION_TIMEOUT_SEC=300      # 起沙箱独立超时（超时 Reaper 判 failed）

# ---- 代码摄入（§10）----
DEEPSONAR_REPO_MAX_FILES=2000        # 摄入文件数上限
DEEPSONAR_REPO_MAX_TOTAL_MB=20       # 摄入总字节上限
DEEPSONAR_REPO_MAX_FILE_KB=512       # 单文件上限（二进制文件一律跳过）
DEEPSONAR_GIT_CLONE_TIMEOUT_SEC=120  # 浅克隆超时
DEEPSONAR_GIT_ALLOWED_HOSTS=         # 逗号分隔 host 白名单；空=任意 https host（仅 https）
DEEPSONAR_REPO_LOCAL_ROOTS=          # 逗号分隔本地根；空=不限制 repo_path
