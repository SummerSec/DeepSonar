{
  "name": "deepflowhunter",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @dfh/scheduler dev",
    "dev:web": "pnpm --filter @dfh/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose -f deploy/docker-compose.yml up -d",
    "db:down": "docker compose -f deploy/docker-compose.yml down",
    "predev": "pnpm -r --filter @dfh/shared-types --filter @dfh/plane-client --filter @dfh/runtime-sandbox build",
    "predev:web": "pnpm -r --filter @dfh/shared-types --filter @dfh/plane-client --filter @dfh/runtime-sandbox build"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
