  "toolsets": {
    "mobile": {
      "imageKey": "deepsonar-mobile",
      "description": "Project-opt-in mobile audit/test runtime for Android, iOS host tools, OpenHarmony HAP/hdc, and lightweight .so analysis (binutils/radare2/LIEF). Includes a pinned CLI-only rust_ASC source build as the default on-demand APK class/manifest/xref CLI (droidasc is a Rust compat entry; Python Droid ASC stays as the explicit droidasc-python fallback) and pinned ApkCheckPack as an Agent-invoked packer/SDK fingerprint CLI. No MobSF, GUI, Burp, IDA, Ghidra, DevEco, MCP servers, or full OH SDK.",
      "maxSizeMiB": 2400
    }
  }
