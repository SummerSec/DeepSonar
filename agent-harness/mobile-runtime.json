      "droidasc": {
        "version": "0.1.1.post1",
        "license": "Apache-2.0",
        "capabilities": ["apk-decompile", "apk-xref-search", "apk-manifest-decode"],
        "role": "explicit-fallback",
        "entrypoint": "droidasc-python",
        "source": "PyPI droidasc (MG1937/ASC); explicit fallback only via droidasc-python (the droidasc command now runs rust_ASC); CLI only — do not use --gui"
