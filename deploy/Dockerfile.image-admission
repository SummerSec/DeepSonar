FROM node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5

RUN apk add --no-cache ca-certificates docker-cli && corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/runtime-manual-contract/package.json packages/runtime-manual-contract/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json
COPY apps/image-admission/package.json apps/image-admission/package.json
RUN pnpm install --frozen-lockfile --filter @deepsonar/image-admission...
COPY packages/runtime-manual-contract packages/runtime-manual-contract
COPY packages/shared-types packages/shared-types
COPY apps/image-admission apps/image-admission
RUN pnpm --filter @deepsonar/shared-types build && pnpm --filter @deepsonar/runtime-manual-contract --filter @deepsonar/image-admission build
ENV NODE_ENV=production
CMD ["pnpm", "--filter", "@deepsonar/image-admission", "start"]
