# DeepSonar default Test runtime. Keep Kali itself minimal: no
# kali-linux-*, kali-tools-*, GUI or desktop metapackage.
ARG BASE_IMAGE=kalilinux/kali-last-release@sha256:01a402ec78a2b3bd86394f34f8c3d6adefe3c593ae259ac0779c4d1f971c8ff5
ARG CA_IMAGE=debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
ARG JDK8_IMAGE=eclipse-temurin:8-jdk@sha256:9fd5233e39b963aad25dae3ca002c5a1b435c378f6d484c24f0c68be34b54b72
ARG JDK11_IMAGE=eclipse-temurin:11-jdk@sha256:51cad80517b1e18e289460e0a48657374d17711c83270263054a4a22cc1a992a
ARG JDK17_IMAGE=eclipse-temurin:17-jdk@sha256:068a8f9ae4b74d9a20de3ecca771ba1a6437f1d7a8a8ad6deaf9dbdd2274397a

FROM ${CA_IMAGE} AS ca-bootstrap
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

FROM ${JDK8_IMAGE} AS jdk8
FROM ${JDK11_IMAGE} AS jdk11
FROM ${JDK17_IMAGE} AS jdk17
FROM ${BASE_IMAGE} AS runtime-rootfs

ARG KALI_MIRROR=https://kali.download/kali
ARG CLAUDE_CODE_VERSION=2.1.231
ARG CODEX_VERSION=0.147.0
ARG OPENCODE_VERSION=1.18.18
ARG PI_CODING_AGENT_VERSION=0.84.1
ARG PI_CODING_AGENT_INTEGRITY=sha512-ncAqFrG+iybuPGOhMiZoEHkEzTpJgz3guYD32pD+M7ucc0WeHmauP6wa7qwP8V/KWvsZDVNa5XGsdZ7fkC7w7A==
ARG DSH_VERSION=0.1.0-rc.6
ARG DSH_JSONRPC_DEMO_INTEGRITY=sha512-LfKyOVUhA0p65+JrlvSBoC7lE6W/VbN5/ubEVgZw2NYDhdPNAg0KhC7fWtahfdycGOTjp8fyUn+rhzLsRmS9eQ==
ARG DSH_JSONRPC_SERVER_INTEGRITY=sha512-VQsoRpqUG55+T0kQtX82P9izWlA5VHBs61vpBvSv/Uv6G40ebmWXB37M5izkCNV4bcWojVfTbKXJus2ruO2ZrA==
ARG DSH_PROTOCOL_INTEGRITY=sha512-0ZDQdLXLc4Uq1WvjopUTAQTxeTNvAJBiSSCrVdCWC/sOwC8ThQfzC48z9kcd7xmjfM1JqOiztBtQ62/Tw2Qt8A==
ARG DSH_AGENT_SPINE_INTEGRITY=sha512-urMS7CReaddhybJZCaPA8oI4VbD/A+62mLTOb2E4b8EKgZ55sMsOGfpkMZmFIs9nqJqxdFUmcxPXWKVMVtpb5w==
ARG DSH_SKILL_INTEGRITY=sha512-VyRlCOASIRuTflKwn4NvbdAXxSPnnLJ+RAQUI4GK5pOtPwI2DhJrbovqpyp5kNAkZMsqvIeHWu5PcCEJ+FpQ2w==
ARG DSH_SKILL_FILESYSTEM_INTEGRITY=sha512-NCgz8lCAdvd0oSGIF0EKg1OXfIC7x9r0an7mgC19F0DGzYZJe5ve6AwEYpSvKITE3V8W4NbUzLKyyZG3VH5QtQ==
ARG DSH_TOOL_SKILL_INTEGRITY=sha512-AebSfHSt6j0PXuN3yK9+X4aC6tHSnFdm2hZglII7aEHr/lL9UbynPb3NTumh6thXZ9Earvwhf9JdOxHMsjHqfw==
ARG DSH_SUBPROCESS_LOCAL_INTEGRITY=sha512-D2daTRaprE25ti1Ra69eURPwLULpnRyUHqAGtcMHddcjNIsZ4yR0DGinYOsgoRymzu3t02qLxyoio05atSViRw==
ARG DSH_CODE_RUNTIME_INTEGRITY=sha512-aw8D4IOeMo11A3uxQeE4LFoW3bvaQnVkGFqqtS+lsINDARrOCJHXLUgecoKpys+Lc5erZZ4UQDnymJmL4OCcKA==
ARG DSH_CODE_RUNTIME_WORKER_INTEGRITY=sha512-I2YX2ZSeQnQrSJGffM2upL+7y7vGsLwKv478gesusgYtT0kH/MOcszO9ZpnV8sIqvlkgzvWgBhXzniGHWh40ZA==
ARG DSH_REASONING_SETTINGS_VERSION=0.3.0
ARG DSH_REASONING_SETTINGS_COMMIT=5768999dbbbb5088fd27f89c85970fe2f7b2c5c6
ARG DSH_REASONING_SETTINGS_SHA256=e583207774b2875c4f5914540a8df699b4f0f947b3e3a28722504237ba3dc6e3
ARG NODE_VERSION=22.23.2
ARG UV_VERSION=0.11.32
ARG UV_AMD64_SHA256=aab924fd522efd06f1c5f3b93a243864fc453132c94b2dc49f1371b528a4b967
ARG UV_ARM64_SHA256=4d4fa08d95b06642e5800df6a22bd71455f23f988269e18da2847971d8c0bf31
ARG SEMGREP_VERSION=1.172.0
ARG GITLEAKS_VERSION=8.30.1
ARG SHELLCHECK_VERSION=0.11.0
ARG MAVEN_VERSION=3.9.16
ARG MAVEN_URL=https://archive.apache.org/dist/maven/maven-3/3.9.16/binaries/apache-maven-3.9.16-bin.tar.gz
ARG MAVEN_SHA512=831a8591fe20c8243b1dbe7d71e3244f31d1665b0804b2e825e38cbbe5ce0cafb8338851f90780735568773e0a6cd07bbec107cda0b896b008b861075358b6f6
ARG SEMGREP_AMD64_SHA256=d8b94af4266a575287ad2cd844573743ab4fe58f6bfb6d9229327807937eade3
ARG SEMGREP_ARM64_SHA256=c881a305b965e594b88b15c2c6419b398e76e438ec61e60916c8b2effe927240
ARG GITLEAKS_AMD64_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
ARG GITLEAKS_ARM64_SHA256=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080
ARG SHELLCHECK_AMD64_SHA256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
ARG SHELLCHECK_ARM64_SHA256=12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588
ARG NODE_AMD64_SHA256=d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307
ARG NODE_ARM64_SHA256=fff4078c5def658577f92c88db7db3bc0072924bfb93fe52c1e744a54e94abb8

ENV DEBIAN_FRONTEND=noninteractive

COPY --from=ca-bootstrap /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=ca-bootstrap /usr/lib/ssl/ /usr/lib/ssl/

RUN set -eu; \
  rm -f /etc/apt/sources.list.d/kali.sources; \
  printf 'deb %s kali-last-snapshot main contrib non-free non-free-firmware\n' "${KALI_MIRROR}" > /etc/apt/sources.list; \
  packages="ca-certificates curl git ripgrep jq file unzip xz-utils python3 python3-venv binutils build-essential pkg-config golang-go rustc cargo"; \
  for attempt in 1 2 3; do \
    if apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends $packages; then break; fi; \
    if [ "$attempt" = 3 ]; then exit 1; fi; \
    rm -rf /var/lib/apt/lists/*; sleep 2; \
  done; \
  rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* \
    /usr/share/doc/* /usr/share/man/* /usr/share/info/* /usr/share/locale/*

RUN set -eu; arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) node_arch=x64; node_sha="$NODE_AMD64_SHA256" ;; \
      arm64) node_arch=arm64; node_sha="$NODE_ARM64_SHA256" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    node_archive="/tmp/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz"; \
    curl -fsSL --retry 5 --retry-all-errors --connect-timeout 20 "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" -o "$node_archive"; \
    echo "$node_sha  $node_archive" | sha256sum -c -; \
    tar -xJf "$node_archive" -C /usr/local --strip-components=1; \
    rm "$node_archive"

RUN set -eu; \
  test "$(npm view @earendil-works/pi-coding-agent@${PI_CODING_AGENT_VERSION} dist.integrity)" = "$PI_CODING_AGENT_INTEGRITY"; \
  test "$(npm view @deepseek-ai/dsh-sdk-jsonrpc-demo@${DSH_VERSION} dist.integrity)" = "$DSH_JSONRPC_DEMO_INTEGRITY"; \
  test "$(npm view @deepseek-ai/dsh-sdk-jsonrpc-server@${DSH_VERSION} dist.integrity)" = "$DSH_JSONRPC_SERVER_INTEGRITY"; \
  test "$(npm view @deepseek-ai/dsh-sdk-protocol@${DSH_VERSION} dist.integrity)" = "$DSH_PROTOCOL_INTEGRITY"; \
  test "$(npm view @deepseek-ai/dsh-agent-spine-demo@${DSH_VERSION} dist.integrity)" = "$DSH_AGENT_SPINE_INTEGRITY"; \
  test "$(npm view @deepseek-ai/dsh-skill@${DSH_VERSION} dist.integrity)" = "$DSH_SKILL_INTEGRITY"; \
  test "$(npm view @deepseek-ai/dsh-skill-filesystem@${DSH_VERSION} dist.integrity)" = "$DSH_SKILL_FILESYSTEM_INTEGRITY"; \
  test "$(npm view @deepseek-ai/dsh-tool-skill@${DSH_VERSION} dist.integrity)" = "$DSH_TOOL_SKILL_INTEGRITY"; \
  test "$(npm view @deepseek-ai/dsh-subprocess-local@${DSH_VERSION} dist.integrity)" = "$DSH_SUBPROCESS_LOCAL_INTEGRITY"; \
  test "$(npm view @deepseek-ai/dsh-code-runtime@${DSH_VERSION} dist.integrity)" = "$DSH_CODE_RUNTIME_INTEGRITY"; \
  test "$(npm view @deepseek-ai/dsh-code-runtime-worker-thread@${DSH_VERSION} dist.integrity)" = "$DSH_CODE_RUNTIME_WORKER_INTEGRITY"; \
  reasoning_archive="/tmp/dsh-reasoning-settings-${DSH_REASONING_SETTINGS_COMMIT}.tar.gz"; \
  curl -fsSL --retry 5 --retry-all-errors --connect-timeout 20 "https://codeload.github.com/JuneLearn/dsh-reasoning-settings/tar.gz/${DSH_REASONING_SETTINGS_COMMIT}" -o "$reasoning_archive"; \
  echo "$DSH_REASONING_SETTINGS_SHA256  $reasoning_archive" | sha256sum -c -; \
  npm install -g --omit=dev --no-audit --no-fund \
  @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
  @openai/codex@${CODEX_VERSION} \
  opencode-ai@${OPENCODE_VERSION} \
  @earendil-works/pi-coding-agent@${PI_CODING_AGENT_VERSION} \
  @deepseek-ai/dsh-sdk-jsonrpc-demo@${DSH_VERSION} \
  @deepseek-ai/dsh-sdk-jsonrpc-server@${DSH_VERSION} \
  @deepseek-ai/dsh-sdk-protocol@${DSH_VERSION} \
  @deepseek-ai/dsh-agent-spine-demo@${DSH_VERSION} \
  @deepseek-ai/dsh-skill@${DSH_VERSION} \
  @deepseek-ai/dsh-skill-filesystem@${DSH_VERSION} \
  @deepseek-ai/dsh-tool-skill@${DSH_VERSION} \
  @deepseek-ai/dsh-llm-pi-ai@${DSH_VERSION} \
  @deepseek-ai/dsh-sandbox-local@${DSH_VERSION} \
  @deepseek-ai/dsh-sandbox-policy@${DSH_VERSION} \
  @deepseek-ai/dsh-subprocess-local@${DSH_VERSION} \
  @deepseek-ai/dsh-bash-local@${DSH_VERSION} \
  @deepseek-ai/dsh-fs-local@${DSH_VERSION} \
  @deepseek-ai/dsh-tool-bash@${DSH_VERSION} \
  @deepseek-ai/dsh-tool-str-replace-editor@${DSH_VERSION} \
  @deepseek-ai/dsh-session-persistence-jsonl@${DSH_VERSION} \
  @deepseek-ai/dsh-session-checkpoint-policy@${DSH_VERSION} \
  @deepseek-ai/dsh-token-meter@${DSH_VERSION} \
  @deepseek-ai/dsh-code-runtime@${DSH_VERSION} \
  @deepseek-ai/dsh-code-runtime-worker-thread@${DSH_VERSION} \
  @deepseek-ai/dsh-compaction-basic@${DSH_VERSION} \
  "$reasoning_archive" \
  && npm list -g --depth=0 "dsh-reasoning-settings@${DSH_REASONING_SETTINGS_VERSION}" >/dev/null \
  && rm -f "$reasoning_archive" \
  && npm cache clean --force

RUN set -eu; arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) uv_arch=x86_64; uv_sha="$UV_AMD64_SHA256" ;; \
      arm64) uv_arch=aarch64; uv_sha="$UV_ARM64_SHA256" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    uv_archive=/tmp/uv.tar.gz; \
    curl -fsSL --retry 5 --retry-all-errors --connect-timeout 20 "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${uv_arch}-unknown-linux-gnu.tar.gz" -o "$uv_archive"; \
    echo "$uv_sha  $uv_archive" | sha256sum -c -; \
    tar -xzf "$uv_archive" -C /usr/local/bin --strip-components=1; \
    rm "$uv_archive"

COPY --from=jdk8 /opt/java/openjdk /opt/deepsonar/jdks/8
COPY --from=jdk11 /opt/java/openjdk /opt/deepsonar/jdks/11
COPY --from=jdk17 /opt/java/openjdk /opt/deepsonar/jdks/17

RUN set -eu; \
    maven_archive="/tmp/apache-maven-${MAVEN_VERSION}-bin.tar.gz"; \
    curl -fsSL --retry 5 --retry-all-errors --connect-timeout 20 "$MAVEN_URL" -o "$maven_archive"; \
    echo "$MAVEN_SHA512  $maven_archive" | sha512sum -c -; \
    rm -rf /opt/deepsonar/maven; mkdir -p /opt/deepsonar/maven; \
    tar -xzf "$maven_archive" -C /opt/deepsonar/maven --strip-components=1; \
    test -x /opt/deepsonar/maven/bin/mvn; \
    ln -s /opt/deepsonar/maven/bin/mvn /usr/local/bin/mvn; \
    rm "$maven_archive"

RUN set -eu; \
    uv --version | grep -Eq "^uv ${UV_VERSION}([[:space:]]|$)"; \
    UV_PYTHON_INSTALL_DIR=/opt/deepsonar/python UV_PYTHON_BIN_DIR=/usr/local/bin uv python install 3.10.20 3.11.15 3.12.13 3.13.14; \
    UV_PYTHON_INSTALL_DIR=/opt/deepsonar/python UV_PYTHON_BIN_DIR=/usr/local/bin uv python install --default 3.14.6; \
    uv cache clean; \
    for version in 8 11 17; do \
      ln -s "/opt/deepsonar/jdks/$version/bin/java" "/usr/local/bin/java$version"; \
      ln -s "/opt/deepsonar/jdks/$version/bin/javac" "/usr/local/bin/javac$version"; \
    done; \
    ln -s /opt/deepsonar/jdks/17/bin/java /usr/local/bin/java; \
    ln -s /opt/deepsonar/jdks/17/bin/javac /usr/local/bin/javac; \
    ln -s /opt/deepsonar/jdks/17/bin/jar /usr/local/bin/jar

RUN set -eu; arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) semgrep_arch=x86_64; semgrep_sha="$SEMGREP_AMD64_SHA256"; gitleaks_arch=x64; gitleaks_sha="$GITLEAKS_AMD64_SHA256"; shellcheck_arch=x86_64; shellcheck_sha="$SHELLCHECK_AMD64_SHA256" ;; \
      arm64) semgrep_arch=aarch64; semgrep_sha="$SEMGREP_ARM64_SHA256"; gitleaks_arch=arm64; gitleaks_sha="$GITLEAKS_ARM64_SHA256"; shellcheck_arch=aarch64; shellcheck_sha="$SHELLCHECK_ARM64_SHA256" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    mkdir -p /tmp/deepsonar-tools /opt/deepsonar/semgrep; \
    semgrep_file="/tmp/deepsonar-tools/semgrep-${SEMGREP_VERSION}-cp310.cp311.cp312.cp313.cp314.py310.py311.py312.py313.py314-none-manylinux_2_34_${semgrep_arch}.whl"; \
    curl -fsSL --retry 5 --retry-all-errors --connect-timeout 20 "https://files.pythonhosted.org/packages/$(test "$arch" = amd64 && printf '84/a5/21624510b65271a673961a894af7511b5123d662e84c74c765560ea28b27' || printf '1b/45/35488f2f609db23eed350ada093722484a6f8cb3b1eaf8ecfd54e2338521')/$(basename "$semgrep_file")" -o "$semgrep_file"; \
    echo "$semgrep_sha  $semgrep_file" | sha256sum -c -; \
    python3 -m venv /opt/deepsonar/semgrep; /opt/deepsonar/semgrep/bin/pip install --no-cache-dir "$semgrep_file"; ln -s /opt/deepsonar/semgrep/bin/semgrep /usr/local/bin/semgrep; \
    curl -fsSL --retry 5 --retry-all-errors --connect-timeout 20 "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${gitleaks_arch}.tar.gz" -o /tmp/deepsonar-tools/gitleaks.tar.gz; \
    echo "$gitleaks_sha  /tmp/deepsonar-tools/gitleaks.tar.gz" | sha256sum -c -; tar -xzf /tmp/deepsonar-tools/gitleaks.tar.gz -C /usr/local/bin gitleaks; \
    curl -fsSL --retry 5 --retry-all-errors --connect-timeout 20 "https://github.com/koalaman/shellcheck/releases/download/v${SHELLCHECK_VERSION}/shellcheck-v${SHELLCHECK_VERSION}.linux.${shellcheck_arch}.tar.xz" -o /tmp/deepsonar-tools/shellcheck.tar.xz; \
    echo "$shellcheck_sha  /tmp/deepsonar-tools/shellcheck.tar.xz" | sha256sum -c -; mkdir /tmp/shellcheck; tar -xJf /tmp/deepsonar-tools/shellcheck.tar.xz -C /tmp/shellcheck --strip-components=1; install -m 0755 /tmp/shellcheck/shellcheck /usr/local/bin/shellcheck; \
    rm -rf /tmp/deepsonar-tools /tmp/shellcheck

COPY agent-harness/kali-minimal-runtime.json /opt/deepsonar/runtime-images.json
COPY agent-harness/write-tool-manifest.mjs /opt/deepsonar/write-tool-manifest.mjs
RUN node /opt/deepsonar/write-tool-manifest.mjs /opt/deepsonar/runtime-images.json kali-minimal /opt/deepsonar/tool-manifest.json \
  && rm /opt/deepsonar/runtime-images.json /opt/deepsonar/write-tool-manifest.mjs \
  && find /var/log -type f -exec truncate -s 0 {} \; \
  && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /root/.cache /root/.m2 /home/*/.m2 /tmp/* /var/tmp/* \
  && find /usr/share/doc /usr/share/man /usr/share/info /usr/share/locale -mindepth 1 -delete 2>/dev/null || true

WORKDIR /workspace

# Keep the specialist runtime small by exporting only the finished filesystem,
# not superseded bytes from package-manager and tool-install layers.
FROM scratch
LABEL io.deepsonar.contract="deepsonar.runtime.contract/v1" \
      io.deepsonar.toolset="kali-minimal" \
      io.deepsonar.tools-manifest="/opt/deepsonar/tool-manifest.json" \
      org.opencontainers.image.title="DeepSonar Kali Test" \
      org.opencontainers.image.description="DeepSonar Test 默认使用的精简 Kali 多语言工具链；不安装 Kali metapackage 或 GUI。" \
      org.opencontainers.image.source="https://github.com/SummerSec/DeepSonar" \
      org.opencontainers.image.documentation="https://github.com/SummerSec/DeepSonar/blob/main/docs/RELEASE_RUNTIME_IMAGES.md" \
      org.opencontainers.image.licenses="LicenseRef-DeepSonar-Proprietary" \
      org.opencontainers.image.base.name="docker.io/kalilinux/kali-last-release"
ENV IS_SANDBOX=1 \
    SEMGREP_SEND_METRICS=off \
    SEMGREP_ENABLE_VERSION_CHECK=0 \
    MAVEN_HOME=/opt/deepsonar/maven \
    JAVA_HOME=/opt/deepsonar/jdks/17 \
    JAVA8_HOME=/opt/deepsonar/jdks/8 \
    JAVA11_HOME=/opt/deepsonar/jdks/11 \
    JAVA17_HOME=/opt/deepsonar/jdks/17 \
    UV_PYTHON_INSTALL_DIR=/opt/deepsonar/python \
    UV_PYTHON_BIN_DIR=/usr/local/bin \
    UV_PYTHON_DOWNLOADS=never \
    PATH=/opt/deepsonar/maven/bin:/opt/deepsonar/jdks/17/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
COPY --from=runtime-rootfs / /
WORKDIR /workspace
CMD ["sleep", "infinity"]
