# DeepSonar default Test runtime. Keep Kali itself minimal: no
# kali-linux-*, kali-tools-*, GUI or desktop metapackage.
ARG BASE_IMAGE=kalilinux/kali-last-release@sha256:01a402ec78a2b3bd86394f34f8c3d6adefe3c593ae259ac0779c4d1f971c8ff5
ARG CA_IMAGE=debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
ARG JDK8_IMAGE=eclipse-temurin:8-jdk@sha256:9fd5233e39b963aad25dae3ca002c5a1b435c378f6d484c24f0c68be34b54b72
ARG JDK11_IMAGE=eclipse-temurin:11-jdk@sha256:51cad80517b1e18e289460e0a48657374d17711c83270263054a4a22cc1a992a
ARG JDK17_IMAGE=eclipse-temurin:17-jdk@sha256:068a8f9ae4b74d9a20de3ecca771ba1a6437f1d7a8a8ad6deaf9dbdd2274397a

FROM ${CA_IMAGE} AS ca-bootstrap
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

FROM ${JDK8_IMAGE} AS jdk8
FROM ${JDK11_IMAGE} AS jdk11
FROM ${JDK17_IMAGE} AS jdk17
FROM ${BASE_IMAGE} AS runtime-rootfs

ARG KALI_MIRROR=https://kali.download/kali
ARG CLAUDE_CODE_VERSION=2.1.312
ARG CLAUDE_CODE_INTEGRITY=sha512-/gx8byG8VOm4YoNuT5tal/Ov5Z5oydJzZkmHCJcBFLbNGGpyYDbKA/CNdB+iIKwcLQC8pVwBoj6Dt7H3L2J5bw==
ARG PI_CODING_AGENT_VERSION=1.4.0
ARG PI_CODING_AGENT_INTEGRITY=sha512-Z41LpZ3yYHSC/UUps6Mr39UMFPwH8elhJBG9DY1P7kuzsE5qSK/6eMj2EHzO5evJRQWLbKSqUMw+4nCNtIyiQg==
ARG DSH_VERSION=0.2.1-rc.2
ARG DSH_INTEGRITY=sha512-tvY+yhfKRifthbqPe/OK0AYxM5ZkvqfYq/jMYgJcEUxiRRL1Vwra3Ti5TB6AXgSWQdiPHYh/Vp6SJa9yHwMNuw==
ARG PI_WEB_ACCESS_VERSION=0.29.0
ARG PI_WEB_ACCESS_INTEGRITY=sha512-1l4sAWYkFhiBynJf/mXuxmCHxjhiAyWJ4rfQVFu8UPa0JQhCS9oXAmNXcL0Q1SfrO00plmb6L4IkypJ3n1Q4Kg==
ARG NODE_VERSION=22.23.2
ARG UV_VERSION=0.11.32
ARG UV_AMD64_SHA256=aab924fd522efd06f1c5f3b93a243864fc453132c94b2dc49f1371b528a4b967
ARG UV_ARM64_SHA256=4d4fa08d95b06642e5800df6a22bd71455f23f988269e18da2847971d8c0bf31
ARG MAVEN_VERSION=3.9.16
ARG MAVEN_URL=https://archive.apache.org/dist/maven/maven-3/3.9.16/binaries/apache-maven-3.9.16-bin.tar.gz
ARG MAVEN_SHA512=831a8591fe20c8243b1dbe7d71e3244f31d1665b0804b2e825e38cbbe5ce0cafb8338851f90780735568773e0a6cd07bbec107cda0b896b008b861075358b6f6
ARG NODE_AMD64_SHA256=d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307
ARG NODE_ARM64_SHA256=fff4078c5def658577f92c88db7db3bc0072924bfb93fe52c1e744a54e94abb8

ENV DEBIAN_FRONTEND=noninteractive

COPY --from=ca-bootstrap /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=ca-bootstrap /usr/lib/ssl/ /usr/lib/ssl/

RUN set -eu; \
  rm -f /etc/apt/sources.list.d/kali.sources; \
  printf 'deb %s kali-last-snapshot main contrib non-free non-free-firmware\n' "${KALI_MIRROR}" > /etc/apt/sources.list; \
  packages="ca-certificates curl git ripgrep jq file unzip xz-utils python3 python3-venv binutils build-essential pkg-config golang-go rustc cargo"; \
  for attempt in 1 2 3; do \
    if apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends $packages; then break; fi; \
    if [ "$attempt" = 3 ]; then exit 1; fi; \
    rm -rf /var/lib/apt/lists/*; sleep 2; \
  done; \
  rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* \
    /usr/share/doc/* /usr/share/man/* /usr/share/info/* /usr/share/locale/*

RUN set -eu; arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) node_arch=x64; node_sha="$NODE_AMD64_SHA256" ;; \
      arm64) node_arch=arm64; node_sha="$NODE_ARM64_SHA256" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    node_archive="/tmp/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz"; \
    curl -fsSL --retry 5 --retry-all-errors --connect-timeout 20 "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" -o "$node_archive"; \
    echo "$node_sha  $node_archive" | sha256sum -c -; \
    tar -xJf "$node_archive" -C /usr/local --strip-components=1; \
    rm "$node_archive"

COPY agent-harness/dsh-runtime/package.json /opt/deepsonar/dsh/package.json
COPY agent-harness/dsh-runtime/package-lock.json /opt/deepsonar/dsh/package-lock.json

RUN set -eu; \
  test "$(npm view @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} dist.integrity)" = "$CLAUDE_CODE_INTEGRITY"; \
  test "$(npm view @earendil-works/pi-coding-agent@${PI_CODING_AGENT_VERSION} dist.integrity)" = "$PI_CODING_AGENT_INTEGRITY"; \
  test "$(node -e 'const p=require("/opt/deepsonar/dsh/package-lock.json").packages["node_modules/@deepseek-ai/dsh"]; process.stdout.write(p?.version ?? "")')" = "$DSH_VERSION"; \
  test "$(node -e 'const p=require("/opt/deepsonar/dsh/package-lock.json").packages["node_modules/@deepseek-ai/dsh"]; process.stdout.write(p?.integrity ?? "")')" = "$DSH_INTEGRITY"; \
  cd /opt/deepsonar/dsh; \
  npm ci --omit=dev --ignore-scripts --no-audit --no-fund; \
  npm install -g --omit=dev --no-audit --no-fund \
    @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
    @earendil-works/pi-coding-agent@${PI_CODING_AGENT_VERSION}; \
  test -x node_modules/@deepseek-ai/dsh/lib/bin.js; \
  ln -sf /opt/deepsonar/dsh/node_modules/@deepseek-ai/dsh/lib/bin.js /usr/local/bin/dsh; \
  npm cache clean --force

RUN set -eu; \
  test "$(npm view pi-web-access@${PI_WEB_ACCESS_VERSION} dist.integrity)" = "$PI_WEB_ACCESS_INTEGRITY"; \
  mkdir -p /opt/deepsonar/pi-extensions; \
  npm install --omit=dev --no-audit --no-fund --prefix /opt/deepsonar/pi-extensions \
    pi-web-access@${PI_WEB_ACCESS_VERSION}; \
  npm cache clean --force

RUN set -eu; arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) uv_arch=x86_64; uv_sha="$UV_AMD64_SHA256" ;; \
      arm64) uv_arch=aarch64; uv_sha="$UV_ARM64_SHA256" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    uv_archive=/tmp/uv.tar.gz; \
    curl -fsSL --retry 5 --retry-all-errors --connect-timeout 20 "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${uv_arch}-unknown-linux-gnu.tar.gz" -o "$uv_archive"; \
    echo "$uv_sha  $uv_archive" | sha256sum -c -; \
    tar -xzf "$uv_archive" -C /usr/local/bin --strip-components=1; \
    rm "$uv_archive"

COPY --from=jdk8 /opt/java/openjdk /opt/deepsonar/jdks/8
COPY --from=jdk11 /opt/java/openjdk /opt/deepsonar/jdks/11
COPY --from=jdk17 /opt/java/openjdk /opt/deepsonar/jdks/17

RUN set -eu; \
    maven_archive="/tmp/apache-maven-${MAVEN_VERSION}-bin.tar.gz"; \
    curl -fsSL --retry 5 --retry-all-errors --connect-timeout 20 "$MAVEN_URL" -o "$maven_archive"; \
    echo "$MAVEN_SHA512  $maven_archive" | sha512sum -c -; \
    rm -rf /opt/deepsonar/maven; mkdir -p /opt/deepsonar/maven; \
    tar -xzf "$maven_archive" -C /opt/deepsonar/maven --strip-components=1; \
    test -x /opt/deepsonar/maven/bin/mvn; \
    ln -s /opt/deepsonar/maven/bin/mvn /usr/local/bin/mvn; \
    rm "$maven_archive"

RUN set -eu; \
    uv --version | grep -Eq "^uv ${UV_VERSION}([[:space:]]|$)"; \
    UV_PYTHON_INSTALL_DIR=/opt/deepsonar/python UV_PYTHON_BIN_DIR=/usr/local/bin uv python install 3.10.20 3.11.15 3.12.13 3.13.14; \
    UV_PYTHON_INSTALL_DIR=/opt/deepsonar/python UV_PYTHON_BIN_DIR=/usr/local/bin uv python install --default 3.14.6; \
    uv cache clean; \
    for version in 8 11 17; do \
      ln -s "/opt/deepsonar/jdks/$version/bin/java" "/usr/local/bin/java$version"; \
      ln -s "/opt/deepsonar/jdks/$version/bin/javac" "/usr/local/bin/javac$version"; \
    done; \
    ln -s /opt/deepsonar/jdks/17/bin/java /usr/local/bin/java; \
    ln -s /opt/deepsonar/jdks/17/bin/javac /usr/local/bin/javac; \
    ln -s /opt/deepsonar/jdks/17/bin/jar /usr/local/bin/jar

COPY agent-harness/kali-minimal-runtime.json /opt/deepsonar/runtime-images.json
COPY agent-harness/write-tool-manifest.mjs /opt/deepsonar/write-tool-manifest.mjs
RUN node /opt/deepsonar/write-tool-manifest.mjs /opt/deepsonar/runtime-images.json kali-minimal /opt/deepsonar/tool-manifest.json \
  && rm /opt/deepsonar/runtime-images.json /opt/deepsonar/write-tool-manifest.mjs \
  && find /var/log -type f -exec truncate -s 0 {} \; \
  && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /root/.cache /root/.m2 /home/*/.m2 /tmp/* /var/tmp/* \
  && find /usr/share/doc /usr/share/man /usr/share/info /usr/share/locale -mindepth 1 -delete 2>/dev/null || true

COPY agent-harness/runtime-manuals /opt/deepsonar/runtime-manuals
COPY agent-harness/materialize-runtime-manuals.mjs /opt/deepsonar/materialize-runtime-manuals.mjs
RUN node /opt/deepsonar/materialize-runtime-manuals.mjs \
  --catalog /opt/deepsonar/runtime-manuals/catalog.json \
  --source-root /opt/deepsonar/runtime-manuals \
  --tool-manifest /opt/deepsonar/tool-manifest.json \
  --output /opt/deepsonar/manuals \
  --image-key deepsonar-kali-minimal \
  && rm -rf /opt/deepsonar/runtime-manuals /opt/deepsonar/materialize-runtime-manuals.mjs

WORKDIR /workspace

# Keep the specialist runtime small by exporting only the finished filesystem,
# not superseded bytes from package-manager and tool-install layers.
FROM scratch
LABEL io.deepsonar.contract="deepsonar.runtime.contract/v1" \
      io.deepsonar.toolset="kali-minimal" \
      io.deepsonar.image-key="deepsonar-kali-minimal" \
      io.deepsonar.tools-manifest="/opt/deepsonar/tool-manifest.json" \
      io.deepsonar.manuals="/opt/deepsonar/manuals/index.json" \
      org.opencontainers.image.title="DeepSonar Kali Test" \
      org.opencontainers.image.description="DeepSonar Test 默认使用的精简 Kali 多语言工具链；不安装 Kali metapackage 或 GUI。" \
      org.opencontainers.image.source="https://github.com/SummerSec/DeepSonar" \
      org.opencontainers.image.documentation="https://github.com/SummerSec/DeepSonar/blob/main/docs/RELEASE_RUNTIME_IMAGES.md" \
      org.opencontainers.image.licenses="LicenseRef-DeepSonar-Proprietary" \
      org.opencontainers.image.base.name="docker.io/kalilinux/kali-last-release"
ENV IS_SANDBOX=1 \
    MAVEN_HOME=/opt/deepsonar/maven \
    JAVA_HOME=/opt/deepsonar/jdks/17 \
    JAVA8_HOME=/opt/deepsonar/jdks/8 \
    JAVA11_HOME=/opt/deepsonar/jdks/11 \
    JAVA17_HOME=/opt/deepsonar/jdks/17 \
    UV_PYTHON_INSTALL_DIR=/opt/deepsonar/python \
    UV_PYTHON_BIN_DIR=/usr/local/bin \
    UV_PYTHON_DOWNLOADS=never \
    PATH=/opt/deepsonar/maven/bin:/opt/deepsonar/jdks/17/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
COPY --from=runtime-rootfs / /
WORKDIR /workspace
CMD ["sleep", "infinity"]
