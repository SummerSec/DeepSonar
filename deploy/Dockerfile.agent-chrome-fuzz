# DeepSonar V8 fuzz runtime. Project opt-in only.
# d8 is built from the pinned V8 source revision. The build fails closed if a
# real d8 cannot be produced; no substitute executable is renamed to d8.
ARG BASE_IMAGE=deepsonar-base:local
FROM ${BASE_IMAGE} AS runtime-rootfs

ARG DEBIAN_SNAPSHOT=20260731T162426Z
ARG DEBIAN_SECURITY_SNAPSHOT=20260731T162426Z
ARG TARGETARCH
ARG V8_REPOSITORY=https://chromium.googlesource.com/v8/v8.git
ARG V8_COMMIT=792d9716fea48312ad7ce4413c538e00628b1d50
ARG V8_VERSION=15.1.206.10
ARG DEPOT_TOOLS_REPOSITORY=https://chromium.googlesource.com/chromium/tools/depot_tools.git
ARG DEPOT_TOOLS_COMMIT=921e61b35fbc5e97b14250a118e363ec05078089
ARG COMPILER_RT_REPOSITORY=https://github.com/llvm/llvm-project.git
ARG COMPILER_RT_COMMIT=53d18800eda3b7407e53366f27ca78e922c6e0db

USER root
RUN set -eux; \
  rm -f /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources; \
  printf 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/%s bookworm main\n' "$DEBIAN_SNAPSHOT" >/etc/apt/sources.list; \
  printf 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/%s bookworm-security main\n' "$DEBIAN_SECURITY_SNAPSHOT" >>/etc/apt/sources.list; \
  apt-get update; \
  apt-get install -y --no-install-recommends \
    ca-certificates curl file git pkg-config clang-16 lld-16 llvm-16 libclang-rt-16-dev libfuzzer-16-dev afl++ binutils ninja-build python3; \
  rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* \
    /usr/share/doc/* /usr/share/man/* /usr/share/info/* /usr/share/locale/*; \
  install -d -m 0755 /opt/deepsonar/bin /opt/deepsonar/lib /workspace

# A shallow, commit-addressed depot_tools checkout makes the source-build
# dependency explicit. gclient then resolves V8 dependencies from the exact
# V8 commit. The pinned Chromium sanitizer config maps use_libfuzzer=true to
# -fsanitize=fuzzer-no-link. Compile compiler-rt's matching libFuzzer revision
# inside the same GN graph. On amd64 V8 keeps its downloaded pinned Clang; on
# native arm64 GN is explicitly pointed at the installed LLVM 16 because the
# downloaded Chromium toolchain is an x86_64 executable. The Debian libFuzzer
# package remains toolchain closure only and is never linked as a replacement.
FROM runtime-rootfs AS v8-builder
ARG TARGETARCH
COPY deploy/chrome-fuzz-toolchain-preflight.sh /usr/local/bin/chrome-fuzz-toolchain-preflight.sh
RUN set -eux; \
  git init /opt/depot_tools; \
  git -C /opt/depot_tools remote add origin "$DEPOT_TOOLS_REPOSITORY"; \
  git -C /opt/depot_tools fetch --depth 1 origin "$DEPOT_TOOLS_COMMIT"; \
  git -C /opt/depot_tools checkout --detach "$DEPOT_TOOLS_COMMIT"; \
  export PATH="/usr/lib/llvm-16/bin:/usr/bin:/opt/depot_tools:$PATH"; \
  mkdir -p /tmp/v8-checkout; \
  cd /tmp/v8-checkout; \
  gclient config --name src "$V8_REPOSITORY"; \
  gclient sync --revision "src@$V8_COMMIT" --no-history --shallow; \
  cd src; \
  git init third_party/deepsonar-compiler-rt; \
  git -C third_party/deepsonar-compiler-rt remote add origin "$COMPILER_RT_REPOSITORY"; \
  git -C third_party/deepsonar-compiler-rt sparse-checkout init --cone; \
  git -C third_party/deepsonar-compiler-rt sparse-checkout set compiler-rt/lib/fuzzer; \
  git -C third_party/deepsonar-compiler-rt fetch --depth 1 --filter=blob:none origin "$COMPILER_RT_COMMIT"; \
  git -C third_party/deepsonar-compiler-rt checkout --detach FETCH_HEAD; \
  printf '%s\n' \
    'v8_source_set("deepsonar_libfuzzer") {' \
    '  testonly = true' \
    '  sources = [' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerCrossOver.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerDataFlowTrace.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerDriver.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerExtFunctionsDlsym.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerExtFunctionsWeak.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerExtFunctionsWindows.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerExtraCounters.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerExtraCountersDarwin.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerExtraCountersWindows.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerFork.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerIO.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerIOPosix.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerIOWindows.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerLoop.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerMain.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerMerge.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerMutate.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerSHA1.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerTracePC.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerUtil.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerUtilDarwin.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerUtilFuchsia.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerUtilLinux.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerUtilPosix.cpp",' \
    '    "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer/FuzzerUtilWindows.cpp",' \
    '  ]' \
    '  include_dirs = [ "third_party/deepsonar-compiler-rt/compiler-rt/lib/fuzzer" ]' \
    '  remove_configs = [' \
    '    "//build/config/compiler:chromium_code",' \
    '    "//build/config/sanitizers:default_sanitizer_flags",' \
    '  ]' \
    '  configs = [' \
    '    "//build/config/compiler:no_chromium_code",' \
    '    "//build/config/sanitizers:default_sanitizer_flags_but_coverage",' \
    '  ]' \
    '}' \
    'v8_executable("v8_json_libfuzzer") {' \
    '  testonly = true' \
    '  deps = [ ":deepsonar_libfuzzer", ":json_fuzzer" ]' \
    '  configs = [ ":external_config" ]' \
    '}' >> BUILD.gn; \
  case "$TARGETARCH" in \
    amd64) target_cpu=x64; gn_toolchain_args='' ;; \
    arm64) target_cpu=arm64; gn_toolchain_args='clang_base_path="/usr/lib/llvm-16" clang_use_chrome_plugins=false' ;; \
    *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
  esac; \
  export CC=clang-16 CXX=clang++-16; \
  gn_args="is_debug=false is_component_build=false is_clang=true is_asan=true use_libfuzzer=true v8_enable_fuzztest=false target_cpu=\"$target_cpu\" v8_enable_i18n_support=false v8_use_external_startup_data=false v8_enable_pointer_compression=true $gn_toolchain_args"; \
  gn gen out/release --args="$gn_args"; \
  /usr/local/bin/chrome-fuzz-toolchain-preflight.sh "$TARGETARCH" out/release; \
  autoninja -C out/release d8 v8_json_libfuzzer; \
  test -x out/release/d8; \
  test -x out/release/v8_json_libfuzzer; \
  test -f out/release/libsanitizer_shared_hooks.so

FROM runtime-rootfs AS runtime-final
COPY --from=v8-builder --chmod=0755 /tmp/v8-checkout/src/out/release/d8 /opt/deepsonar/bin/d8
COPY --from=v8-builder --chmod=0755 /tmp/v8-checkout/src/out/release/v8_json_libfuzzer /opt/deepsonar/bin/v8_json_libfuzzer
COPY --from=v8-builder --chmod=0755 /tmp/v8-checkout/src/out/release/libsanitizer_shared_hooks.so /opt/deepsonar/lib/libsanitizer_shared_hooks.so
ENV LD_LIBRARY_PATH=/opt/deepsonar/lib
RUN /opt/deepsonar/bin/d8 --version | grep -E '^V8'

COPY deploy/chrome-fuzz-env.sh /tmp/chrome-fuzz-env.sh
COPY deploy/chrome-fuzz-smoke.sh /tmp/chrome-fuzz-smoke.sh
RUN set -eux; \
  install -m 0755 /tmp/chrome-fuzz-env.sh /opt/deepsonar/bin/chrome-fuzz-env.sh; \
  install -m 0755 /tmp/chrome-fuzz-smoke.sh /opt/deepsonar/bin/chrome-fuzz-smoke.sh; \
  rm -f /tmp/chrome-fuzz-env.sh /tmp/chrome-fuzz-smoke.sh; \
  if ! getent group deepsonar >/dev/null; then groupadd --gid 1001 deepsonar; fi; \
  if ! id deepsonar >/dev/null 2>&1; then useradd --uid 1001 --gid deepsonar --create-home --shell /bin/bash deepsonar; fi; \
  node -e 'const fs=require("node:fs"); const m={contract:"deepsonar.runtime.contract/v1",toolset:"chrome-fuzz",imageKey:"deepsonar-chrome-fuzz",project_opt_in:true,tools:["clang-16","clang++-16","lld-16","llvm-16","compiler-rt","libFuzzer-16","AFL++","binutils","v8-source","d8","v8_json_libfuzzer","node","claude"],fuzz:{target:"d8",libfuzzer_target:"v8_json_libfuzzer",actual:true,source:"v8",libfuzzer_source:"pinned compiler-rt source compiled in the V8 GN graph; Debian libfuzzer-16-dev is not linked",v8_commit:"792d9716fea48312ad7ce4413c538e00628b1d50",v8_version:"15.1.206.10",depot_tools_commit:"921e61b35fbc5e97b14250a118e363ec05078089",compiler_rt_commit:"53d18800eda3b7407e53366f27ca78e922c6e0db"},entrypoints:{check:"/opt/deepsonar/bin/chrome-fuzz-env.sh",smoke:"/opt/deepsonar/bin/chrome-fuzz-smoke.sh",d8:"/opt/deepsonar/bin/d8",libfuzzer:"/opt/deepsonar/bin/v8_json_libfuzzer"}}; fs.writeFileSync("/opt/deepsonar/tool-manifest.json",JSON.stringify(m,null,2)+"\n")'; \
  chown -R deepsonar:deepsonar /opt/deepsonar /workspace

ENV IS_SANDBOX=1 \
    CC=clang \
    CXX=clang++ \
    AFL_SKIP_CPUFREQ=1 \
    LD_LIBRARY_PATH=/opt/deepsonar/lib \
    PATH=/opt/deepsonar/bin:/usr/lib/llvm-16/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /workspace
RUN /opt/deepsonar/bin/chrome-fuzz-env.sh --check

FROM scratch
LABEL io.deepsonar.contract="deepsonar.runtime.contract/v1" \
      io.deepsonar.toolset="chrome-fuzz" \
      io.deepsonar.tools-manifest="/opt/deepsonar/tool-manifest.json" \
      org.opencontainers.image.title="DeepSonar Chrome Fuzz" \
      org.opencontainers.image.description="Project-opt-in real V8 d8 built from a pinned source revision with Clang/LLVM, compiler-rt/libFuzzer and AFL++." \
      org.opencontainers.image.source="https://github.com/SummerSec/DeepSonar" \
      org.opencontainers.image.documentation="https://github.com/SummerSec/DeepSonar/blob/main/docs/RELEASE_RUNTIME_IMAGES.md" \
      org.opencontainers.image.licenses="LicenseRef-DeepSonar-Proprietary"
ENV IS_SANDBOX=1 \
    CC=clang \
    CXX=clang++ \
    AFL_SKIP_CPUFREQ=1 \
    LD_LIBRARY_PATH=/opt/deepsonar/lib \
    PATH=/opt/deepsonar/bin:/usr/lib/llvm-16/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
COPY --from=runtime-final / /
WORKDIR /workspace
USER deepsonar
CMD ["sleep", "infinity"]
