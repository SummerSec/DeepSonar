# DeepSonar official Agent runtime. Build with TOOLSET=base or TOOLSET=audit.
ARG BASE_IMAGE=node:22-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46
FROM ${BASE_IMAGE} AS runtime-rootfs

ARG TOOLSET=base
ARG GIT_VERSION=1:2.39.5-0+deb12u3
ARG PYTHON_VERSION=3.11.2-1+b1
ARG CA_CERTIFICATES_VERSION=20230311+deb12u1
ARG CURL_VERSION=7.88.1-10+deb12u15
ARG RIPGREP_VERSION=13.0.0-4+b2
ARG JQ_VERSION=1.6-2.1+deb12u3
ARG FILE_VERSION=1:5.44-3
ARG UNZIP_VERSION=6.0-28
ARG XZ_VERSION=5.4.1-1+deb12u2
ARG BINUTILS_VERSION=2.40-2
ARG TARGETARCH
ARG FD_VERSION=10.3.0
ARG FD_AMD64_SHA256=2b6bfaae8c48f12050813c2ffe1884c61ea26e750d803df9c9114550a314cd14
ARG FD_ARM64_SHA256=996b9b1366433b211cb3bbedba91c9dbce2431842144d925428ead0adf32020b
ARG CLAUDE_CODE_VERSION=2.1.312
ARG CLAUDE_CODE_INTEGRITY=sha512-/gx8byG8VOm4YoNuT5tal/Ov5Z5oydJzZkmHCJcBFLbNGGpyYDbKA/CNdB+iIKwcLQC8pVwBoj6Dt7H3L2J5bw==
ARG PI_CODING_AGENT_VERSION=1.5.2
ARG PI_CODING_AGENT_INTEGRITY=sha512-mUWI04rqF1Vd/m1q+Ps1XeWsTXEVvRUnsmRa83I3Dzua0Tx5bYS93imeqtIfrXf7PkkaR6ERz+AuQhIJlom5yA==
ARG DSH_VERSION=0.2.1-rc.2
ARG DSH_INTEGRITY=sha512-tvY+yhfKRifthbqPe/OK0AYxM5ZkvqfYq/jMYgJcEUxiRRL1Vwra3Ti5TB6AXgSWQdiPHYh/Vp6SJa9yHwMNuw==
ARG PI_WEB_ACCESS_VERSION=0.29.0
ARG PI_WEB_ACCESS_INTEGRITY=sha512-1l4sAWYkFhiBynJf/mXuxmCHxjhiAyWJ4rfQVFu8UPa0JQhCS9oXAmNXcL0Q1SfrO00plmb6L4IkypJ3n1Q4Kg==
ARG PI_OBSERVATIONAL_MEMORY_VERSION=3.1.4
ARG PI_OBSERVATIONAL_MEMORY_INTEGRITY=sha512-jgQbFyLMs4wWhkf6F0voOgzMwtIXsb8+ks0MsPKpPxkdpyMX5E/el6Mk/vJ40m8GlKwBIsCKjL1r7Z2U8dCtmA==

COPY agent-harness/base-apt-runtime.json agent-harness/base-apt-inputs.mjs /opt/deepsonar/
COPY agent-harness/base-cli-lifecycle.json agent-harness/base-cli-install.mjs /opt/deepsonar/
RUN set -eu; \
  node /opt/deepsonar/base-apt-inputs.mjs /opt/deepsonar/base-apt-runtime.json; \
  test "$TOOLSET" = base -o "$TOOLSET" = audit; \
  packages="git=${GIT_VERSION} python3=${PYTHON_VERSION} ca-certificates=${CA_CERTIFICATES_VERSION} curl=${CURL_VERSION} ripgrep=${RIPGREP_VERSION} jq=${JQ_VERSION} libjq1=${JQ_VERSION} file=${FILE_VERSION} unzip=${UNZIP_VERSION} xz-utils=${XZ_VERSION}"; \
  if [ "$TOOLSET" = audit ]; then packages="$packages binutils=${BINUTILS_VERSION}"; fi; \
  for attempt in 1 2 3; do \
    if apt-get -o Acquire::Retries=3 update; then \
      node /opt/deepsonar/base-apt-inputs.mjs /opt/deepsonar/base-apt-runtime.json verify-lists; \
      if apt-get -o Acquire::Retries=3 install -y --no-install-recommends $packages; then break; fi; \
    fi; \
    if [ "$attempt" = 3 ]; then exit 1; fi; \
    rm -rf /var/lib/apt/lists/*; sleep 2; \
  done; \
  rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* \
    /usr/share/doc/* /usr/share/man/* /usr/share/info/* /usr/share/locale/*

# Pi's find tool needs --no-require-git (fd >= 8.7); bookworm fd-find is older.
# A PATH binary also avoids Pi's unverified releases/latest download at runtime.
RUN set -eu; \
  case "$TARGETARCH" in \
    amd64) target=x86_64; sha="$FD_AMD64_SHA256" ;; \
    arm64) target=aarch64; sha="$FD_ARM64_SHA256" ;; \
    *) echo "Unsupported fd architecture: $TARGETARCH" >&2; exit 1 ;; \
  esac; \
  name="fd-v${FD_VERSION}-${target}-unknown-linux-musl"; \
  curl -fsSL --retry 3 --max-time 60 "https://github.com/sharkdp/fd/releases/download/v${FD_VERSION}/${name}.tar.gz" -o /tmp/fd.tar.gz; \
  echo "$sha  /tmp/fd.tar.gz" | sha256sum -c -; \
  tar -xzf /tmp/fd.tar.gz -C /tmp "$name/fd" "$name/LICENSE-MIT" "$name/LICENSE-APACHE"; \
  install -m 0755 "/tmp/$name/fd" /usr/local/bin/fd; \
  mkdir -p /usr/local/share/licenses/fd; \
  cp "/tmp/$name/LICENSE-MIT" "/tmp/$name/LICENSE-APACHE" /usr/local/share/licenses/fd/; \
  fd --no-require-git --glob --max-results 1 '*' /tmp >/dev/null; \
  rm -rf "/tmp/$name" /tmp/fd.tar.gz

COPY agent-harness/base-cli-runtime/package.json /opt/deepsonar/base-cli/package.json
COPY agent-harness/base-cli-runtime/package-lock.json /opt/deepsonar/base-cli/package-lock.json
COPY agent-harness/pi-extensions-base-runtime/package.json /opt/deepsonar/pi-extensions/package.json
COPY agent-harness/pi-extensions-base-runtime/package-lock.json /opt/deepsonar/pi-extensions/package-lock.json
COPY agent-harness/dsh-runtime/package.json /opt/deepsonar/dsh/package.json
COPY agent-harness/dsh-runtime/package-lock.json /opt/deepsonar/dsh/package-lock.json
COPY agent-harness/dsh-request-budget-install.mjs /opt/deepsonar/dsh-request-budget-install.mjs
COPY packages/runtime-sandbox/src/dsh-request-budget.ts packages/runtime-sandbox/src/pi-main-request-budget.ts /opt/deepsonar/request-budget-source/

RUN set -eu; \
  node -e 'const p=require("/opt/deepsonar/base-cli/package-lock.json").packages; for(const [name,version,integrity] of [["@anthropic-ai/claude-code",process.argv[1],process.argv[2]],["@earendil-works/pi-coding-agent",process.argv[3],process.argv[4]]]) if(p["node_modules/"+name]?.version!==version||p["node_modules/"+name]?.integrity!==integrity) throw new Error("BASE_CLI_LOCK_IDENTITY_MISMATCH");' "$CLAUDE_CODE_VERSION" "$CLAUDE_CODE_INTEGRITY" "$PI_CODING_AGENT_VERSION" "$PI_CODING_AGENT_INTEGRITY"; \
  test "$(node -e 'const p=require("/opt/deepsonar/dsh/package-lock.json").packages["node_modules/@deepseek-ai/dsh"]; process.stdout.write(p?.version ?? "")')" = "$DSH_VERSION"; \
  test "$(node -e 'const p=require("/opt/deepsonar/dsh/package-lock.json").packages["node_modules/@deepseek-ai/dsh"]; process.stdout.write(p?.integrity ?? "")')" = "$DSH_INTEGRITY"; \
  cd /opt/deepsonar/dsh; \
  npm ci --omit=dev --ignore-scripts --no-audit --no-fund; \
  node /opt/deepsonar/dsh-request-budget-install.mjs /opt/deepsonar/dsh /opt/deepsonar/request-budget-source; \
  npm ci --omit=dev --no-audit --no-fund --prefix /opt/deepsonar/base-cli; \
  cp -a /opt/deepsonar/base-cli/node_modules/. "$(npm root -g)/"; \
  rm -rf /opt/deepsonar/base-cli/node_modules; \
  ln -sf /usr/local/lib/node_modules/.bin/claude /usr/local/bin/claude; \
  ln -sf /usr/local/lib/node_modules/.bin/pi /usr/local/bin/pi; \
  node /opt/deepsonar/base-cli-install.mjs "$(npm root -g)" /opt/deepsonar/base-cli/package-lock.json /usr/local/bin "$TARGETARCH"; \
  test -x node_modules/@deepseek-ai/dsh/lib/bin.js; \
  ln -sf /opt/deepsonar/dsh/node_modules/@deepseek-ai/dsh/lib/bin.js /usr/local/bin/dsh; \
  npm cache clean --force

RUN set -eu; \
  test "$TOOLSET" = base -o "$TOOLSET" = audit; \
  test "$(node -e 'const p=require("/opt/deepsonar/pi-extensions/package-lock.json").packages["node_modules/pi-observational-memory"]; process.stdout.write(p?.version ?? "")')" = "$PI_OBSERVATIONAL_MEMORY_VERSION"; \
  test "$(node -e 'const p=require("/opt/deepsonar/pi-extensions/package-lock.json").packages["node_modules/pi-observational-memory"]; process.stdout.write(p?.integrity ?? "")')" = "$PI_OBSERVATIONAL_MEMORY_INTEGRITY"; \
  npm ci --omit=dev --ignore-scripts --no-audit --no-fund --prefix /opt/deepsonar/pi-extensions; \
  node -e 'const fs=require("node:fs"),root=process.argv[3]||"/opt/deepsonar/pi-extensions",p=JSON.parse(fs.readFileSync(root+"/package-lock.json")).packages["node_modules/pi-observational-memory"],installed=JSON.parse(fs.readFileSync(root+"/node_modules/pi-observational-memory/package.json")); if(p?.version!==process.argv[1]||p?.integrity!==process.argv[2]||p?.resolved!=="https://registry.npmjs.org/pi-observational-memory/-/pi-observational-memory-"+process.argv[1]+".tgz"||installed.name!=="pi-observational-memory"||installed.version!==process.argv[1]||installed.license!=="MIT"||!fs.existsSync(root+"/node_modules/pi-observational-memory/src/index.ts")) throw new Error("PI_OM_INSTALL_IDENTITY_MISMATCH");' "$PI_OBSERVATIONAL_MEMORY_VERSION" "$PI_OBSERVATIONAL_MEMORY_INTEGRITY"; \
  if [ "$TOOLSET" != audit ]; then npm cache clean --force; exit 0; fi; \
  test "$(npm view pi-web-access@${PI_WEB_ACCESS_VERSION} dist.integrity)" = "$PI_WEB_ACCESS_INTEGRITY"; \
  npm install --omit=dev --no-audit --no-fund --prefix /opt/deepsonar/pi-extensions \
    pi-web-access@${PI_WEB_ACCESS_VERSION}; \
  npm cache clean --force

COPY agent-harness/pi-observational-memory-governed.ts /opt/deepsonar/pi-extensions/deepsonar-observational-memory.ts
RUN test -s /opt/deepsonar/pi-extensions/deepsonar-observational-memory.ts

COPY agent-harness/runtime-images.json /opt/deepsonar/runtime-images.json
COPY agent-harness/write-tool-manifest.mjs /opt/deepsonar/write-tool-manifest.mjs
RUN node /opt/deepsonar/write-tool-manifest.mjs /opt/deepsonar/runtime-images.json "$TOOLSET" /opt/deepsonar/tool-manifest.json \
  && rm /opt/deepsonar/runtime-images.json /opt/deepsonar/write-tool-manifest.mjs

COPY agent-harness/runtime-manuals /opt/deepsonar/runtime-manuals
COPY agent-harness/materialize-runtime-manuals.mjs /opt/deepsonar/materialize-runtime-manuals.mjs
RUN node /opt/deepsonar/materialize-runtime-manuals.mjs \
  --catalog /opt/deepsonar/runtime-manuals/catalog.json \
  --source-root /opt/deepsonar/runtime-manuals \
  --tool-manifest /opt/deepsonar/tool-manifest.json \
  --output /opt/deepsonar/manuals \
  --image-key "deepsonar-$TOOLSET" \
  && rm -rf /opt/deepsonar/runtime-manuals /opt/deepsonar/materialize-runtime-manuals.mjs

WORKDIR /workspace

# Collapse the finished rootfs into one runtime layer. This removes bytes hidden
# behind package upgrades/deletions in earlier layers, so the enforced size
# budget reflects what users actually pull and store.
FROM scratch
ARG TOOLSET=base
ARG OCI_TITLE="DeepSonar Runtime"
ARG OCI_DESCRIPTION="DeepSonar official governed Agent sandbox runtime."
LABEL io.deepsonar.contract="deepsonar.runtime.contract/v1" \
      io.deepsonar.toolset="${TOOLSET}" \
      io.deepsonar.image-key="deepsonar-${TOOLSET}" \
      io.deepsonar.tools-manifest="/opt/deepsonar/tool-manifest.json" \
      io.deepsonar.manuals="/opt/deepsonar/manuals/index.json" \
      org.opencontainers.image.title="${OCI_TITLE}" \
      org.opencontainers.image.description="${OCI_DESCRIPTION}" \
      org.opencontainers.image.source="https://github.com/SummerSec/DeepSonar" \
      org.opencontainers.image.documentation="https://github.com/SummerSec/DeepSonar/blob/main/docs/RELEASE_RUNTIME_IMAGES.md" \
      org.opencontainers.image.licenses="LicenseRef-DeepSonar-Proprietary"
ENV IS_SANDBOX=1
COPY --from=runtime-rootfs / /
WORKDIR /workspace
CMD ["sleep", "infinity"]
