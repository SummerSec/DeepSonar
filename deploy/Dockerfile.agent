# DeepSonar 沙箱 Agent 镜像（生产制品，§12.1：基础镜像与 npm 包全部固定版本/Digest）
# 与 agent-harness/image.mjs 等价（该文件供本地 agentbox CLI 快速构建；CI/发布一律走本文件）
FROM node:20-bookworm@sha256:8f693eaa7e0a8e71560c9a82b55fd54c2ae920a2ba5d2cde28bac7d1c01c9ba5

ENV IS_SANDBOX=1

RUN apt-get update \
  && apt-get install -y --no-install-recommends git python3 ca-certificates ripgrep \
  && rm -rf /var/lib/apt/lists/*

# 版本升级走显式改 ARG（可审计），不装 latest
ARG CLAUDE_CODE_VERSION=2.1.220
ARG CLAUDE_AGENT_SDK_VERSION=0.3.220
RUN npm install -g \
  @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
  @anthropic-ai/claude-agent-sdk@${CLAUDE_AGENT_SDK_VERSION} \
  && npm cache clean --force

WORKDIR /workspace
CMD ["sleep", "infinity"]
