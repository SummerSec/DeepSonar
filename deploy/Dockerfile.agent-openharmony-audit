# DeepSonar OpenHarmony 高危静态审计运行时。
# 面向内存安全 / 提权类假设挖掘：Clang 静态分析、Sanitizer 可编译工具链。
# 不包含全量源码或板级固件；不安装密钥扫描器。
ARG BASE_IMAGE=deepsonar-base:local
FROM ${BASE_IMAGE} AS runtime-rootfs

USER root
ARG REPO_SHA256=2410cfea0b746fa175acd7130116e3cab26fb2f1cb8107e7a030cd50b0f2c020
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential ccache cmake ninja-build git-lfs python3-requests python-is-python3 \
    openssh-client rsync patch pkg-config \
    clang clang-tidy clang-tools llvm lld libclang-rt-dev \
    libasan8 libubsan1 liblsan0 \
    gdb binutils \
    sparse cppcheck bear \
  && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* \
    /usr/share/doc/* /usr/share/man/* /usr/share/info/* /usr/share/locale/* \
  && git lfs install --system \
  && install -d -m 0755 /opt/deepsonar/bin /workspace

COPY deploy/vendor/gitcode-repo-py3 /tmp/repo
RUN echo "$REPO_SHA256  /tmp/repo" | sha256sum -c - \
  && install -m 0755 /tmp/repo /usr/local/bin/repo \
  && rm -f /tmp/repo

COPY deploy/openharmony-env.sh /tmp/openharmony-env.sh
COPY deploy/openharmony-init.sh /tmp/openharmony-init.sh
COPY deploy/openharmony-build.sh /tmp/openharmony-build.sh
COPY deploy/openharmony-audit-env.sh /tmp/openharmony-audit-env.sh
COPY deploy/openharmony-audit-scan.sh /tmp/openharmony-audit-scan.sh
RUN install -m 0755 /tmp/openharmony-env.sh /opt/deepsonar/bin/openharmony-env.sh \
  && install -m 0755 /tmp/openharmony-init.sh /opt/deepsonar/bin/openharmony-init.sh \
  && install -m 0755 /tmp/openharmony-build.sh /opt/deepsonar/bin/openharmony-build.sh \
  && install -m 0755 /tmp/openharmony-audit-env.sh /opt/deepsonar/bin/openharmony-audit-env.sh \
  && install -m 0755 /tmp/openharmony-audit-scan.sh /opt/deepsonar/bin/openharmony-audit-scan.sh \
  && rm -f /tmp/openharmony-env.sh /tmp/openharmony-init.sh /tmp/openharmony-build.sh \
    /tmp/openharmony-audit-env.sh /tmp/openharmony-audit-scan.sh \
  && if ! getent group deepsonar >/dev/null; then groupadd --gid 1001 deepsonar; fi \
  && if ! id deepsonar >/dev/null 2>&1; then useradd --uid 1001 --gid deepsonar --create-home --shell /bin/bash deepsonar; fi \
  && chown -R deepsonar:deepsonar /opt/deepsonar /workspace

RUN /opt/deepsonar/bin/openharmony-env.sh --check \
  && /opt/deepsonar/bin/openharmony-audit-env.sh --check \
  && node -e 'const fs=require("node:fs"); const m={"contract":"deepsonar.runtime.contract/v1","toolset":"openharmony-audit","imageKey":"deepsonar-openharmony-audit","tools":["git","git-lfs","repo","python3","build-essential","ccache","cmake","ninja","clang","clang-tidy","scan-build","llvm-symbolizer","compiler-rt","gdb","objdump","addr2line","sparse","cppcheck","bear","libasan","libubsan","node","claude"],"focus":["oob","uaf","integer-overflow","privilege-escalation","memory-safety"],"source":{"manifest":"https://gitcode.com/openharmony/manifest.git","branch":"master"},"entrypoints":{"check":"/opt/deepsonar/bin/openharmony-audit-env.sh","init":"/opt/deepsonar/bin/openharmony-init.sh","build":"/opt/deepsonar/bin/openharmony-build.sh","scan":"/opt/deepsonar/bin/openharmony-audit-scan.sh"}}; fs.writeFileSync("/opt/deepsonar/tool-manifest.json", JSON.stringify(m,null,2)+"\\n")'

ENV IS_SANDBOX=1 \
    OPENHARMONY_SOURCE_DIR=/workspace/openharmony \
    CC=clang \
    CXX=clang++ \
    PATH=/opt/deepsonar/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /workspace

FROM scratch
LABEL io.deepsonar.contract="deepsonar.runtime.contract/v1" \
      io.deepsonar.toolset="openharmony-audit" \
      io.deepsonar.tools-manifest="/opt/deepsonar/tool-manifest.json" \
      org.opencontainers.image.title="DeepSonar OpenHarmony Audit" \
      org.opencontainers.image.description="OpenHarmony 高危静态审计环境：Clang/clang-tidy/cppcheck/sparse 与 ASan/UBSan 工具链；不含全量源码或固件。" \
      org.opencontainers.image.source="https://github.com/SummerSec/DeepSonar" \
      org.opencontainers.image.documentation="https://github.com/SummerSec/DeepSonar/blob/main/docs/RELEASE_RUNTIME_IMAGES.md" \
      org.opencontainers.image.licenses="MIT"
ENV IS_SANDBOX=1 \
    OPENHARMONY_SOURCE_DIR=/workspace/openharmony \
    CC=clang \
    CXX=clang++ \
    PATH=/opt/deepsonar/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
COPY --from=runtime-rootfs / /
WORKDIR /workspace
USER deepsonar
CMD ["sleep", "infinity"]
