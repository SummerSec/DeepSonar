# DeepSonar OpenHarmony 动态验证 / Fuzz 运行时。
# 用于证伪或确认高危 Finding：libFuzzer、AFL++、ASan/UBSan。
# 不包含全量源码、板级固件或 GUI；不安装 Kali metapackage。
ARG BASE_IMAGE=deepsonar-base:local
FROM ${BASE_IMAGE} AS runtime-rootfs
ARG TARGETARCH

USER root
ARG REPO_SHA256=2410cfea0b746fa175acd7130116e3cab26fb2f1cb8107e7a030cd50b0f2c020
# LLVM 19 includes the ASan allocator/PIE fix (upstream fb77ca05).
# Build AFL++ against the same LLVM: Debian's AFL++ package embeds LLVM 14 paths.
ARG LLVM_PACKAGE_VERSION=1:19.1.7-3~deb12u1
ARG AFL_COMMIT=c340a022e2546488c15f85593d0f37e30eeaab3a
ARG AFL_SHA256=77d3dcc321ac4514cf5a9dccd0d070c4a3a417df1d353a01b89540c83090ff41
ENV PATH=/opt/deepsonar/bin:/usr/lib/llvm-19/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential ccache cmake ninja-build git-lfs python3-requests python-is-python3 \
    openssh-client rsync patch pkg-config \
    clang-19="$LLVM_PACKAGE_VERSION" clang-tools-19="$LLVM_PACKAGE_VERSION" \
    llvm-19="$LLVM_PACKAGE_VERSION" llvm-19-dev="$LLVM_PACKAGE_VERSION" \
    lld-19="$LLVM_PACKAGE_VERSION" libclang-rt-19-dev="$LLVM_PACKAGE_VERSION" \
    libasan8 libubsan1 liblsan0 \
    gdb binutils \
  && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* \
    /usr/share/doc/* /usr/share/man/* /usr/share/info/* /usr/share/locale/* \
  && git lfs install --system \
  && install -d -m 0755 /opt/deepsonar/bin /workspace

# Upstream recursively expands -j$(nproc); bound that make variable as well.
RUN set -eux; \
  curl -fsSLo /tmp/deepsonar-afl.tar.gz "https://codeload.github.com/AFLplusplus/AFLplusplus/tar.gz/$AFL_COMMIT"; \
  echo "$AFL_SHA256  /tmp/deepsonar-afl.tar.gz" | sha256sum -c -; \
  install -d /tmp/deepsonar-afl-src /opt/deepsonar/licenses/aflplusplus; \
  tar -xzf /tmp/deepsonar-afl.tar.gz --strip-components=1 -C /tmp/deepsonar-afl-src; \
  make -C /tmp/deepsonar-afl-src -j2 CC=clang-19 CXX=clang++-19 LLVM_CONFIG=llvm-config-19 nproc=2 NO_NYX=1 NO_PYTHON=1 all; \
  make -C /tmp/deepsonar-afl-src -f GNUmakefile.llvm -j2 CC=clang-19 CXX=clang++-19 LLVM_CONFIG=llvm-config-19 all; \
  make -C /tmp/deepsonar-afl-src CC=clang-19 CXX=clang++-19 LLVM_CONFIG=llvm-config-19 nproc=2 NO_NYX=1 NO_PYTHON=1 install; \
  test -s /usr/local/lib/afl/SanitizerCoveragePCGUARD.so; \
  test -s /usr/local/lib/afl/afl-compiler-rt.o; \
  install -m 0644 /tmp/deepsonar-afl-src/LICENSE /opt/deepsonar/licenses/aflplusplus/LICENSE; \
  printf '%s\n' "$AFL_COMMIT" > /opt/deepsonar/licenses/aflplusplus/SOURCE_COMMIT; \
  test "$(readlink -f /tmp/deepsonar-afl-src)" = /tmp/deepsonar-afl-src; \
  rm -rf /tmp/deepsonar-afl-src; \
  rm -f /tmp/deepsonar-afl.tar.gz

COPY deploy/vendor/gitcode-repo-py3 /tmp/repo
RUN sed -i 's/\r$//' /tmp/repo \
  && echo "$REPO_SHA256  /tmp/repo" | sha256sum -c - \
  && install -m 0755 /tmp/repo /usr/local/bin/repo \
  && rm -f /tmp/repo

COPY deploy/openharmony-env.sh /tmp/openharmony-env.sh
COPY deploy/openharmony-init.sh /tmp/openharmony-init.sh
COPY deploy/openharmony-build.sh /tmp/openharmony-build.sh
COPY deploy/openharmony-fuzz-env.sh /tmp/openharmony-fuzz-env.sh
COPY deploy/openharmony-fuzz-build.sh /tmp/openharmony-fuzz-build.sh
RUN install -m 0755 /tmp/openharmony-env.sh /opt/deepsonar/bin/openharmony-env.sh \
  && install -m 0755 /tmp/openharmony-init.sh /opt/deepsonar/bin/openharmony-init.sh \
  && install -m 0755 /tmp/openharmony-build.sh /opt/deepsonar/bin/openharmony-build.sh \
  && install -m 0755 /tmp/openharmony-fuzz-env.sh /opt/deepsonar/bin/openharmony-fuzz-env.sh \
  && install -m 0755 /tmp/openharmony-fuzz-build.sh /opt/deepsonar/bin/openharmony-fuzz-build.sh \
  && rm -f /tmp/openharmony-env.sh /tmp/openharmony-init.sh /tmp/openharmony-build.sh \
    /tmp/openharmony-fuzz-env.sh /tmp/openharmony-fuzz-build.sh \
  && if ! getent group deepsonar >/dev/null; then groupadd --gid 1001 deepsonar; fi \
  && if ! id deepsonar >/dev/null 2>&1; then useradd --uid 1001 --gid deepsonar --create-home --shell /bin/bash deepsonar; fi \
  && chown -R deepsonar:deepsonar /opt/deepsonar /workspace

RUN /opt/deepsonar/bin/openharmony-env.sh --check \
  && node -e 'const fs=require("node:fs"); const m={"contract":"deepsonar.runtime.contract/v1","toolset":"openharmony-fuzz","imageKey":"deepsonar-openharmony-fuzz","tools":["git","git-lfs","repo","python3","build-essential","ccache","cmake","ninja","clang","llvm-symbolizer","compiler-rt","libfuzzer","afl-fuzz","afl-clang-fast","gdb","objdump","addr2line","libasan","libubsan","node","claude"],"focus":["dynamic-verify","crash-repro","harness-fuzz"],"source":{"manifest":"https://gitcode.com/openharmony/manifest.git","branch":"master"},"entrypoints":{"check":"/opt/deepsonar/bin/openharmony-fuzz-env.sh","init":"/opt/deepsonar/bin/openharmony-init.sh","build":"/opt/deepsonar/bin/openharmony-build.sh","fuzzBuild":"/opt/deepsonar/bin/openharmony-fuzz-build.sh"}}; fs.writeFileSync("/opt/deepsonar/tool-manifest.json", JSON.stringify(m,null,2)+"\n")' \
  && if [ "$TARGETARCH" = "arm64" ]; then \
       /opt/deepsonar/bin/openharmony-fuzz-env.sh --check --static; \
     else \
       /opt/deepsonar/bin/openharmony-fuzz-env.sh --check; \
     fi

COPY agent-harness/runtime-manuals /opt/deepsonar/runtime-manuals
COPY agent-harness/materialize-runtime-manuals.mjs /opt/deepsonar/materialize-runtime-manuals.mjs
RUN node /opt/deepsonar/materialize-runtime-manuals.mjs \
  --catalog /opt/deepsonar/runtime-manuals/catalog.json \
  --source-root /opt/deepsonar/runtime-manuals \
  --tool-manifest /opt/deepsonar/tool-manifest.json \
  --output /opt/deepsonar/manuals \
  --image-key deepsonar-openharmony-fuzz \
  && rm -rf /opt/deepsonar/runtime-manuals /opt/deepsonar/materialize-runtime-manuals.mjs

ENV IS_SANDBOX=1 \
    OPENHARMONY_SOURCE_DIR=/workspace/openharmony \
    CC=clang \
    CXX=clang++ \
    AFL_CC=clang-19 \
    AFL_CXX=clang++-19 \
    AFL_LLVM_INSTRUMENT=PCGUARD \
    AFL_SKIP_CPUFREQ=1 \
    AFL_I_DONT_CARE_ABOUT_MISSING_CRASHES=1 \
    PATH=/opt/deepsonar/bin:/usr/lib/llvm-19/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /workspace

FROM scratch
LABEL io.deepsonar.contract="deepsonar.runtime.contract/v1" \
      io.deepsonar.toolset="openharmony-fuzz" \
      io.deepsonar.image-key="deepsonar-openharmony-fuzz" \
      io.deepsonar.tools-manifest="/opt/deepsonar/tool-manifest.json" \
      io.deepsonar.manuals="/opt/deepsonar/manuals/index.json" \
      org.opencontainers.image.title="DeepSonar OpenHarmony Fuzz" \
      org.opencontainers.image.description="OpenHarmony 动态验证与 Fuzz 环境：libFuzzer、AFL++、ASan/UBSan；不含全量源码或固件。" \
      org.opencontainers.image.source="https://github.com/SummerSec/DeepSonar" \
      org.opencontainers.image.documentation="https://github.com/SummerSec/DeepSonar/blob/main/docs/RELEASE_RUNTIME_IMAGES.md" \
      org.opencontainers.image.licenses="LicenseRef-DeepSonar-Proprietary"
ENV IS_SANDBOX=1 \
    OPENHARMONY_SOURCE_DIR=/workspace/openharmony \
    CC=clang \
    CXX=clang++ \
    AFL_CC=clang-19 \
    AFL_CXX=clang++-19 \
    AFL_LLVM_INSTRUMENT=PCGUARD \
    AFL_SKIP_CPUFREQ=1 \
    AFL_I_DONT_CARE_ABOUT_MISSING_CRASHES=1 \
    PATH=/opt/deepsonar/bin:/usr/lib/llvm-19/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
COPY --from=runtime-rootfs / /
WORKDIR /workspace
USER deepsonar
CMD ["sleep", "infinity"]
