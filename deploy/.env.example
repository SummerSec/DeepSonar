# 一键部署脚本会复制为 deploy/.env，并自动替换下面两个 change-me 值。
POSTGRES_PASSWORD=change-me-postgres-password
DFH_ADMIN_TOKEN=change-me-bootstrap-admin-token
DFH_TOKEN_ENV=prod
DFH_WEB_PORT=8080
DFH_MASTER_KEY_FILE=/run/secrets/dfh_master_key

# 默认 fake 可直接验证完整编排；真实 Agent 使用 deploy 脚本的 real 模式。
AGENT_MODE=fake
AGENT_PROVIDER=claude-code
AGENT_MODEL=
DOCKER_IMAGE_AUDIT=deepflowhunter-agent:latest

# 真实 Agent 凭据（按 provider 选择）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=

# 可选 Plane 集成
PLANE_BASE_URL=https://api.plane.so
PLANE_API_TOKEN=
PLANE_WORKSPACE_SLUG=
PLANE_WEB_URL=
PLANE_READY_STATE=Ready
PLANE_WEBHOOK_SECRET=

# 调度与资源限制
MAX_GLOBAL_JOBS=6
MAX_JOBS_PER_PROJECT=2
DFH_HUB_ENABLED=true
DFH_HUB_MAX_ROUNDS=10
DFH_HUB_MAX_INTENTS=3
DFH_SANDBOX_CPU=2
DFH_SANDBOX_MEMORY_MIB=2048
DFH_SANDBOX_PIDS=512
DFH_SANDBOX_CAP_DROP_ALL=true
DFH_SANDBOX_NO_NEW_PRIVILEGES=true
DFH_ALLOWED_ENV_KEYS=ANTHROPIC_*,OPENAI_*,OPENROUTER_*

# 代码摄入限制
DFH_REPO_MAX_FILES=2000
DFH_REPO_MAX_TOTAL_MB=20
DFH_REPO_MAX_FILE_KB=512
DFH_GIT_CLONE_TIMEOUT_SEC=120
DFH_GIT_ALLOWED_HOSTS=
DFH_REPO_LOCAL_ROOTS=
