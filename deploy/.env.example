# 一键部署脚本会复制为 deploy/.env，并自动替换下面四个 change-me 值。
POSTGRES_PASSWORD=change-me-postgres-password
DEEPSONAR_ADMIN_TOKEN=change-me-bootstrap-admin-token
DEEPSONAR_TOKEN_ENV=prod
DEEPSONAR_WEB_PORT=8080
DEEPSONAR_MASTER_KEY_FILE=/run/secrets/deepsonar_master_key

# 空库首次启动自动创建人类管理员：admin / Deep@Sonar66；生产登录后必须立即修改密码并建议修改登录名。
# 默认口令公开且只用于开箱；已有用户或重启不会重置密码。

# ---- 应用镜像（默认从阿里云 ACR 拉取，不本地 build）----
# deploy.sh up 默认 real pull；本地构建：./deploy/deploy.sh up real build
DEEPSONAR_IMAGE_REGISTRY=crpi-6s5wwv0nhl6dq1l0.cn-hangzhou.personal.cr.aliyuncs.com/summersec
DEEPSONAR_IMAGE_TAG=0.1.34
# Postgres 基础镜像（Docker Hub 慢时可改为 docker.m.daocloud.io/library/postgres:16-alpine）
POSTGRES_IMAGE=postgres:16-alpine
# Rootless Podman 时指向用户 sock，例如 /tmp/podman-run-1000/podman/podman.sock
# DEEPSONAR_DOCKER_SOCK=/var/run/docker.sock

# 默认 real：真实沙箱执行。仅验证状态机时改为 fake。
AGENT_MODE=real
# 共享资产卷写入 helper；real 部署会显式预拉，必须使用 immutable digest；fake 不使用
DEEPSONAR_SHARED_ASSETS_HELPER_IMAGE=docker.io/library/busybox@sha256:fc6dddc4c44b1bfe37f41cae8e67d1693828e8f42a91862816d7953e2c9d3f23
# 角色的 agent_cli/model/env_vars 只能通过 RoleConfig / Agents UI/API 设置；Job 创建时冻结快照。
DOCKER_IMAGE_AUDIT=deepsonar-agent:latest

# 官方运行时必须用不可变 digest。不配时 fake 模式使用确定性虚拟快照；real 模式无可信版本会拒绝建 Job。
DEEPSONAR_OFFICIAL_BASE_IMAGE=
DEEPSONAR_OFFICIAL_AUDIT_IMAGE=
DEEPSONAR_OFFICIAL_KALI_MINIMAL_IMAGE=
DEEPSONAR_ALLOWED_IMAGE_REGISTRIES=ghcr.io,docker.io,registry-1.docker.io,crpi-6s5wwv0nhl6dq1l0.cn-hangzhou.personal.cr.aliyuncs.com
# 可选：Scheduler 读取的 SummerSec/DeepSonar GitHub Release metadata/asset token；最小 contents:read，不下发沙箱。
DEEPSONAR_RUNTIME_REGISTRY_GITHUB_TOKEN=

# 独立镜像准入 Worker；扫描器自身也必须固定 digest。
DEEPSONAR_COSIGN_IMAGE=
DEEPSONAR_SYFT_IMAGE=
DEEPSONAR_TRIVY_IMAGE=
DEEPSONAR_CLAMAV_IMAGE=
DEEPSONAR_IMAGE_ADMISSION_POLL_MS=5000
DEEPSONAR_IMAGE_UPDATE_CHECK_SEC=21600
DEEPSONAR_IMAGE_RESCAN_SEC=86400
DEEPSONAR_IMAGE_SCAN_VOLUME=deepsonar_admission_scan

# Provider settings 由 Settings / Credentials UI/API 保存，并按 Job 完整物化为 CLI 配置文件。

# 可选 Plane 集成
PLANE_BASE_URL=https://api.plane.so
PLANE_API_TOKEN=
PLANE_WORKSPACE_SLUG=
PLANE_WEB_URL=
PLANE_READY_STATE=Ready
PLANE_WEBHOOK_SECRET=

# 调度与资源限制
MAX_GLOBAL_JOBS=12
MAX_JOBS_PER_PROJECT=4
PROVISION_CONCURRENCY=2       # global_settings.maxConcurrentProvisioning 缺失时 fallback；vfs 主机应在数据库中设为 1
PROVISION_TIMEOUT_SEC=900      # rootless Docker + vfs 冷启动可能需要 4-8 分钟
DEEPSONAR_HUB_ENABLED=true
DEEPSONAR_HUB_MAX_ROUNDS=20
DEEPSONAR_HUB_MAX_INTENTS=6
DEEPSONAR_SANDBOX_CPU=2
DEEPSONAR_SANDBOX_MEMORY_MIB=2048
DEEPSONAR_SANDBOX_PIDS=512
DEEPSONAR_SANDBOX_CAP_DROP_ALL=true
DEEPSONAR_SANDBOX_NO_NEW_PRIVILEGES=true
DEEPSONAR_ALLOWED_ENV_KEYS=ANTHROPIC_*,OPENAI_*

# 代码摄入限制
DEEPSONAR_REPO_MAX_FILES=2000
DEEPSONAR_REPO_MAX_TOTAL_MB=20
DEEPSONAR_REPO_MAX_FILE_KB=512
DEEPSONAR_GIT_CLONE_TIMEOUT_SEC=120
DEEPSONAR_GIT_ALLOWED_HOSTS=
DEEPSONAR_REPO_LOCAL_ROOTS=

# 冷存储（compose volume 挂载点 /app/data）
# 证据/报告始终写本地 BLOB_DIR；共享资产 CAS 使用官方 Silo 或任意 S3 兼容存储
BLOB_STORE=s3
BLOB_DIR=/app/data/blobs
# 如改用外部对象存储，覆盖以下 S3 连接参数（见 docs/SHARED_ASSET_BLOB_STORE.md）
BLOB_S3_ENDPOINT=http://silo:9000
BLOB_S3_REGION=us-east-1
BLOB_S3_BUCKET=deepsonar
BLOB_S3_ACCESS_KEY_ID=change-me-silo-access-key
BLOB_S3_SECRET_ACCESS_KEY=change-me-silo-secret-key
BLOB_S3_FORCE_PATH_STYLE=true
SILO_API_BIND=127.0.0.1:9000
SILO_CONSOLE_BIND=127.0.0.1:9001
SILO_IMAGE=docker.io/pgsty/silo:RELEASE.2026-08-06T00-00-00Z
